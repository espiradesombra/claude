37 6.136 4.40303 6.07083 4.80371 6.03809C5.14051 6.01057 5.53708 6.00551 6.00391 6.00391C6.00551 5.53708 6.01057 5.14051 6.03809 4.80371C6.0755 4.34588 6.15483 3.94012 6.34668 3.56348L6.46875 3.34473C6.77282 2.84912 7.20856 2.44514 7.72949 2.17969L7.87207 2.11328C8.20855 1.96886 8.56979 1.90385 8.9707 1.87109C9.42091 1.83432 9.978 1.83496 10.667 1.83496H13.5C14.1891 1.83496 14.746 1.83431 15.1963 1.87109C15.6541 1.90851 16.0599 1.98788 16.4365 2.17969L16.6553 2.30176C17.151 2.60585 17.5548 3.04244 17.8203 3.56348L17.8867 3.70606C18.031 4.04235 18.0962 4.40306 18.1289 4.80371C18.1657 5.25395 18.165 5.81091 18.165 6.5V9.33301Z"></path></svg>Copiar código</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre!"><span><span><span class="hljs-comment">// INPUT: n,m,v, E_type (ej. "2n+1" o "E_custom"), límites de búsqueda</span></span><span>
</span><span><span class="hljs-comment">// PRECONDICIONES: n&gt;=m, V := v * product_{k=m+1..n} k  (lo calculamos por producto), listas de primos hasta cierto B.</span></span><span>

</span><span><span class="hljs-function">func <span class="hljs-title">find_contradictory_witness</span></span></span><span><span class="hljs-params">(n, m, v, E_type, prime_bound)</span></span><span>:
    // </span><span><span class="hljs-number">1</span></span><span>) calcular V
    R = </span><span><span class="hljs-number">1</span></span><span>
    </span><span><span class="hljs-function"><span class="hljs-keyword">for</span></span></span><span> k in </span><span><span class="hljs-title">range</span></span><span><span class="hljs-params">(m+<span class="hljs-number">1</span></span></span><span>, n+</span><span><span class="hljs-number">1</span></span><span>):
        R *= k
    V = v * R

    </span><span><span class="hljs-comment">// 2) calcular E</span></span><span>
    </span><span><span class="hljs-keyword">if</span></span><span> E_type == </span><span><span class="hljs-string">"2n+1"</span></span><span>: E = </span><span><span class="hljs-number">2</span></span><span>*n + </span><span><span class="hljs-number">1</span></span><span>
    elif E_type == </span><span><span class="hljs-string">"pair"</span></span><span>: E = (</span><span><span class="hljs-number">2</span></span><span>*n + </span><span><span class="hljs-number">3</span></span><span>) * (</span><span><span class="hljs-number">2</span></span><span>*m + </span><span><span class="hljs-number">3</span></span><span>)
    </span><span><span class="hljs-keyword">else</span></span><span>: E = </span><span><span class="hljs-built_in">evaluate_custom_E</span></span><span>(n,m)

    </span><span><span class="hljs-comment">// 3) obtener lista de primos candidatos para p que dividen V</span></span><span>
    primes_dividing_V = []
    </span><span><span class="hljs-keyword">for</span></span><span> p in </span><span><span class="hljs-built_in">primes_up_to</span></span><span>(</span><span><span class="hljs-built_in">min</span></span><span>(prime_bound, </span><span><span class="hljs-built_in">floor</span></span><span>(</span><span><span class="hljs-built_in">abs</span></span><span>(V)**</span><span><span class="hljs-number">0.5</span></span><span>)+</span><span><span class="hljs-number">1</span></span><span>)):
        </span><span><span class="hljs-keyword">if</span></span><span> V % p == </span><span><span class="hljs-number">0</span></span><span>:
            primes_dividing_V.</span><span><span class="hljs-built_in">append</span></span><span>(p)
    </span><span><span class="hljs-comment">// si V tiene factor primo grande &gt; prime_bound, hay que intentar factoring parcial o uso de GCD con</span></span><span>
    </span><span><span class="hljs-comment">// valores candidatos; aquí asumimos prime_bound suficiente para hallar testigos prácticos</span></span><span>

    </span><span><span class="hljs-comment">// 4) para cada p en primes_dividing_V testear compatibilidad con factorizaciones 6k±1</span></span><span>
    </span><span><span class="hljs-keyword">for</span></span><span> p in primes_dividing_V:
        </span><span><span class="hljs-comment">// a) si p divides E:</span></span><span>
        </span><span><span class="hljs-keyword">if</span></span><span> E % p != </span><span><span class="hljs-number">0</span></span><span>: 
            </span><span><span class="hljs-keyword">continue</span></span><span>  </span><span><span class="hljs-comment">// p no es divisor de E, no es testigo relevante</span></span><span>
        </span><span><span class="hljs-comment">// b) comprobar si p puede dividir algún factor A de forma (6k±1) con A | E</span></span><span>
        possible = False
        </span><span><span class="hljs-comment">// enumerar candidates A divisores de E hasta sqrt(E)</span></span><span>
        </span><span><span class="hljs-keyword">for</span></span><span> A in </span><span><span class="hljs-built_in">divisors_up_to_sqrt</span></span><span>(E):
            </span><span><span class="hljs-keyword">if</span></span><span> E % A != </span><span><span class="hljs-number">0</span></span><span>: </span><span><span class="hljs-keyword">continue</span></span><span>
            B = E </span><span><span class="hljs-comment">// A</span></span><span>
            </span><span><span class="hljs-keyword">if</span></span><span> (A % </span><span><span class="hljs-number">6</span></span><span> == </span><span><span class="hljs-number">1</span></span><span> </span><span><span class="hljs-keyword">or</span></span><span> A % </span><span><span class="hljs-number">6</span></span><span> == </span><span><span class="hljs-number">5</span></span><span>) </span><span><span class="hljs-built_in">and</span></span><span> (B % </span><span><span class="hljs-number">6</span></span><span> == </span><span><span class="hljs-number">1</span></span><span> </span><span><span class="hljs-keyword">or</span></span><span> B % </span><span><span class="hljs-number">6</span></span><span> == </span><span><span class="hljs-number">5</span></span><span>):
                </span><span><span class="hljs-comment">// comprobar si p | A or p | B</span></span><span>
                </span><span><span class="hljs-keyword">if</span></span><span> A % p == </span><span><span class="hljs-number">0</span></span><span> </span><span><span class="hljs-keyword">or</span></span><span> B % p == </span><span><span class="hljs-number">0</span></span><span>:
                    possible = True
                    </span><span><span class="hljs-keyword">break</span></span><span>
        </span><span><span class="hljs-keyword">if</span></span><span> </span><span><span class="hljs-keyword">not</span></span><span> possible:
            </span><span><span class="hljs-comment">// p es testigo contradictorio: p | V y p | E pero no cabe en factores (6k±1)</span></span><span>
            </span><span><span class="hljs-keyword">return</span></span><span> { </span><span><span class="hljs-string">"witness"</span></span><span>: p, </span><span><span class="hljs-string">"V"</span></span><span>: V, </span><span><span class="hljs-string">"E"</span></span><span>: E, </span><span><span class="hljs-string">"reason"</span></span><span>: </span><span><span class="hljs-string">"no compatible with 6k±1 factorization"</span></span><span> }

    </span><span><span class="hljs-keyword">return</span></span><span> None  </span><span><span class="hljs-comment">// no se encontró testigo contradictorio dentro de bound</span></span><span>
</span></span></code></div></div></pre>
<p data-start="6853" data-end="6881"><strong data-start="6853" data-end="6881">Notas de implementación:</strong></p>
<ul data-start="6882" data-end="7337">
<li data-start="6882" data-end="6928">
<p data-start="6884" data-end="6928"><code data-start="6884" data-end="6901">primes_up_to(B)</code> se implementa por criba.</p>
</li>
<li data-start="6929" data-end="7086">
<p data-start="6931" data-end="7086"><code data-start="6931" data-end="6955">divisors_up_to_sqrt(E)</code> lista divisores <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>A</mi><mo>≤</mo><msqrt><mi>E</mi></msqrt></mrow><annotation encoding="application/x-tex">A\le\sqrt E</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 0.8193em; vertical-align: -0.136em;"></span><span class="mord mathnormal">A</span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">≤</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 1.04em; vertical-align: -0.1133em;"></span><span class="mord sqrt"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height: 0.9267em;"><span class="svg-align" style="top: -3em;"><span class="pstrut" style="height: 3em;"></span><span class="mord mathnormal" style="margin-right: 0.05764em; padding-left: 0.833em;">E</span></span><span style="top: -2.8867em;"><span class="pstrut" style="height: 3em;"></span><span class="hide-tail" style="min-width: 0.853em; height: 1.08em;"><svg xmlns="http://www.w3.org/2000/svg" width="400em" height="1.08em" viewBox="0 0 400000 1080" preserveAspectRatio="xMinYMin slice"><path d="M95,702
