import time
import math
import subprocess
import threading
import sys

# ====================== EL ORGANISMO EN PYTHON ======================

def latido_propio():
    return time.monotonic_ns() % 1000

def choque_externo(inercia):
    while (latido_propio() % 121) != (inercia % 121):
        time.sleep(0.00001)                    # micro-espera para no matar CPU
    start = time.perf_counter()
    try:
        result = subprocess.run(
            ["ping", "-c", "1", "-W", "1", "8.8.8.8"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=2
        )
        success = result.returncode == 0
    except:
        success = False
    end = time.perf_counter()
    return int((end - start) * 1_000_000) if success else (latido_propio() + 500)

def mascara_sagrada(x, a, medida):
    dx = 1.0 if x <= 0 else float(x)
    da = float(a)
    return (-math.pow(10.0, 1.0/dx) + math.pow(10.0, 1.0/(dx + da)) - 1.0) * float(medida)

def pulso_gauss(v, p):
    return abs(v - p) <= 1

def robar_bit_pila():
    local = 42
    return (id(local) >> 6) & 0x01

def robar_mierda_heap():
    static_basura = [0]          # truco para simular variable estática
    return (id(static_basura) ^ latido_propio()) & 0xFF

def interprete_lila(b_ext, b_pila, mierda):
    par = (b_ext << 1) | b_pila
    rot = mierda % 3
    base = 0 if (par == 0b11 or par == 0b00) else (1 if par == 0b01 else 2)
    return (base + rot) % 3

def criba_suicida(var):
    pass  # Python no necesita borrar memoria manualmente

# ====================== FUNCIONES PRIMALES ======================
def salto_6k_pos(k):
    return 6 * k + 1

def salto_6k_neg(k):
    return 6 * k - 1

# ====================== ESTADO COMPARTIDO ======================
lock = threading.Lock()
carpeta_codigos = [salto_6k_pos, salto_6k_neg]
vivos = [2]                                          # lista mutable para compartir

def renacer_organismo():
    print("\n=== RESONANCIA FINAL ===")
    print("¡TODOS LOS HILOS MUERTOS! Renacimiento atómico...\n")
    carpeta_codigos[0] = salto_6k_pos
    carpeta_codigos[1] = salto_6k_neg
    vivos[0] = 2
    print(">>> ORGANISMO RECARGADO. Nueva inercia inyectada.\n")

# ====================== HILO ALEATOROVIX ======================
def hilo_aleatorovix(id_hilo):
    while True:
        with lock:
            if vivos[0] == 0:
                renacer_organismo()
                continue

            a = latido_propio()
            x = choque_externo(a)
            res_curva = mascara_sagrada(x, a, 65537 + id_hilo)
            medida = abs(int(res_curva)) % 10
            mierda = robar_mierda_heap()

            r0 = interprete_lila(pulso_gauss(medida, 0), robar_bit_pila(), mierda)
            r5 = interprete_lila(pulso_gauss(medida, 5), robar_bit_pila(), mierda)
            r9 = interprete_lila(pulso_gauss(medida, 9), robar_bit_pila(), mierda)
            decision = (r0 + r5 + r9) % 4

            sys.stdout.write(f"[HILO {id_hilo}] X:{x} A:{a} M:{medida} → DECISIÓN:{decision} ")

            if decision == 1 and carpeta_codigos[0]:
                primo = salto_6k_pos(65537 + id_hilo)
                sys.stdout.write(f"→ SALTO PRIMO: {primo}\n")
                carpeta_codigos[0] = None
                vivos[0] -= 1
            elif decision == 2 and carpeta_codigos[1]:
                primo = salto_6k_neg(65537 + id_hilo)
                sys.stdout.write(f"→ BAILE PRIMO: {primo}\n")
                carpeta_codigos[1] = None
                vivos[0] -= 1
            elif decision == 3:
                sys.stdout.write(f"→ ZYPYZAPE (resto {(65537 + id_hilo) % 121})\n")
            else:
                sys.stdout.write("→ OLVIDO (Criba activada)\n")

            sys.stdout.flush()

        time.sleep(0.03 + id_hilo * 0.01)   # ritmos distintos como en C

# ====================== MAIN ======================
if __name__ == "__main__":
    print("=== ALEATOROVIX v∞ (PYTHON) HA DESPERTADO ===")
    print("Sintonizando el vacío... para siempre.\n")

    hilos = []
    for i in range(4):
        t = threading.Thread(target=hilo_aleatorovix, args=(i,), daemon=True)
        t.start()
        hilos.append(t)

    # Mantiene el programa vivo
    try:
        while True:
            time.sleep(1)
    except KeyboardInterrupt:
        print("\n\n¡Aleatorovix se ha dormido! (Ctrl+C)")

