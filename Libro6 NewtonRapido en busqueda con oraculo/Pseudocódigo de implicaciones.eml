7 6.136 4.40303 6.07083 4.80371 6.03809C5.14051 6.01057 5.53708 6.00551 6.00391 6.00391C6.00551 5.53708 6.01057 5.14051 6.03809 4.80371C6.0755 4.34588 6.15483 3.94012 6.34668 3.56348L6.46875 3.34473C6.77282 2.84912 7.20856 2.44514 7.72949 2.17969L7.87207 2.11328C8.20855 1.96886 8.56979 1.90385 8.9707 1.87109C9.42091 1.83432 9.978 1.83496 10.667 1.83496H13.5C14.1891 1.83496 14.746 1.83431 15.1963 1.87109C15.6541 1.90851 16.0599 1.98788 16.4365 2.17969L16.6553 2.30176C17.151 2.60585 17.5548 3.04244 17.8203 3.56348L17.8867 3.70606C18.031 4.04235 18.0962 4.40306 18.1289 4.80371C18.1657 5.25395 18.165 5.81091 18.165 6.5V9.33301Z"></path></svg>Copiar código</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre!"><span><span><span class="hljs-comment">// --- FUNCIONES AUXILIARES CRT (iterativo) ---</span></span><span>
</span><span><span class="hljs-comment">// resuelve x ≡ a1 (mod m1) y x ≡ a2 (mod m2)</span></span><span>
</span><span><span class="hljs-comment">// asume gcd(m1,m2)=1 para simplicidad; si no, habría que manejar coherencia</span></span><span>
</span><span><span class="hljs-function"><span class="hljs-keyword">func</span></span></span><span> </span><span><span class="hljs-title">crt_pair</span></span><span><span class="hljs-params">(a1, m1, a2, m2)</span></span><span>:
    </span><span><span class="hljs-comment">// devuelve (x, M) con x ≡ a1 (mod m1), x ≡ a2 (mod m2) y M = lcm(m1,m2)=m1*m2 if coprime</span></span><span>
    </span><span><span class="hljs-comment">// calculamos inversa de m1 modulo m2</span></span><span>
    inv = mod_inverse(m1 % m2, m2)   </span><span><span class="hljs-comment">// inv*m1 ≡ 1 (mod m2)</span></span><span>
    </span><span><span class="hljs-comment">// solución base:</span></span><span>
    t = ((a2 - a1) % m2) * inv % m2
    x = a1 + m1 * t
    M = m1 * m2
    x = x % M
    </span><span><span class="hljs-keyword">return</span></span><span> (x, M)

</span><span><span class="hljs-comment">// --- CALCULAR FERMAT Y B_n ---</span></span><span>
</span><span><span class="hljs-function"><span class="hljs-keyword">func</span></span></span><span> </span><span><span class="hljs-title">fermat_number</span></span><span><span class="hljs-params">(n)</span></span><span>:
    </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-number">2</span></span><span>^(</span><span><span class="hljs-number">2</span></span><span>^n) + </span><span><span class="hljs-number">1</span></span><span>     </span><span><span class="hljs-comment">// tener cuidado: crecerá muy rápido; usar enteros grandes</span></span><span>

</span><span><span class="hljs-function"><span class="hljs-keyword">func</span></span></span><span> </span><span><span class="hljs-title">product_fermat_up_to</span></span><span><span class="hljs-params">(n)</span></span><span>:
    P = </span><span><span class="hljs-number">1</span></span><span>
    </span><span><span class="hljs-keyword">for</span></span><span> k from </span><span><span class="hljs-number">0</span></span><span> to n:
        P = P * fermat_number(k)
    </span><span><span class="hljs-keyword">return</span></span><span> P

</span><span><span class="hljs-function"><span class="hljs-keyword">func</span></span></span><span> </span><span><span class="hljs-title">compute_B_n</span></span><span><span class="hljs-params">(n)</span></span><span>:
    </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-number">2</span></span><span> * product_fermat_up_to(n)

</span><span><span class="hljs-comment">// --- CALCULAR r_n con CRT iterativo ---</span></span><span>
</span><span><span class="hljs-comment">// sistema:</span></span><span>
</span><span><span class="hljs-comment">//    r ≡ 1 (mod 2)</span></span><span>
</span><span><span class="hljs-comment">//    r ≡ 2 (mod F_0)</span></span><span>
</span><span><span class="hljs-comment">//    r ≡ 2 (mod F_1)</span></span><span>
</span><span><span class="hljs-comment">//    ...</span></span><span>
</span><span><span class="hljs-comment">//    r ≡ 2 (mod F_n)</span></span><span>
</span><span><span class="hljs-function"><span class="hljs-keyword">func</span></span></span><span> </span><span><span class="hljs-title">compute_r_n</span></span><span><span class="hljs-params">(n)</span></span><span>:
    </span><span><span class="hljs-comment">// empezar con la congruencia modulo 2</span></span><span>
    r = </span><span><span class="hljs-number">1</span></span><span>
    M = </span><span><span class="hljs-number">2</span></span><span>
    </span><span><span class="hljs-keyword">for</span></span><span> k from </span><span><span class="hljs-number">0</span></span><span> to n:
        Fk = fermat_number(k)
        </span><span><span class="hljs-comment">// resolver r ≡ r (mod M) y r ≡ 2 (mod Fk)</span></span><span>
        </span><span><span class="hljs-comment">// suponemos gcd(M, Fk) = 1 — en la práctica lo son porque Fk son impares y primos relativos entre sí</span></span><span>
        (r_new, M_new) = crt_pair(r, M, </span><span><span class="hljs-number">2</span></span><span> % Fk, Fk)
        r = r_new % M_new
        M = M_new
    </span><span><span class="hljs-comment">// r es la solución modulo M = 2 * Π_{k=0}^n Fk  = B_n</span></span><span>
    </span><span><span class="hljs-keyword">return</span></span><span> (r, M)   </span><span><span class="hljs-comment">// devuelve r_n y módulo B_n</span></span><span>

</span><span><span class="hljs-comment">// --- USO: comprobar alineación de Fermat mayores ---</span></span><span>
</span><span><span class="hljs-function"><span class="hljs-keyword">func</span></span></span><span> </span><span><span class="hljs-title">verify_alignment</span></span><span><span class="hljs-params">(n, m)</span></span><span>:
    </span><span><span class="hljs-comment">// calcula r_n y B_n</span></span><span>
    (r, B) = compute_r_n(n)
    Fm = fermat_number(m)
    </span><span><span class="hljs-keyword">if</span></span><span> (Fm - r) % B == </span><span><span class="hljs-number">0</span></span><span>:
        </span><span><span class="hljs-keyword">return</span></span><span> TRUE
    </span><span><span class="hljs-keyword">else</span></span><span>:
        </span><span><span class="hljs-keyword">return</span></span><span> FALSE
</span></span></code></div></div></pre>
<p data-start="5012" data-end="5038"><strong data-start="5012" data-end="5038">Comentarios prácticos:</strong></p>
<ul data-start="5039" data-end="5505">
<li data-start="5039" data-end="5233">
<p data-start="5041" data-end="5233">Los Fermat crecen muy rápido; <code data-start="5071" data-end="5080">2^(2^n)</code> es astronómico para <code data-start="5101" data-end="5108">n ≥ 6</code>. Para uso computacional práctico sólo se puede trabajar con <code data-start="5169" data-end="5172">n</code> muy pequeños o con aritmética de enteros grandes (bignum).</p>
</li>
<li data-start="5234" data-end="5505">
<p data-start="5236" data-end="5505">La suposición <code data-start="5250" data-end="5265">gcd(M, F_k)=1</code> suele cumplirse por la naturaleza de Fermat numbers (tienen propiedades de coprimalidad entre distintos F_i), pero en una implementación robusta hay que verificar compatibilidad de congruencias antes de aplicar CRT (y manejar casos gcd≠1).</p>
</li>
</ul>
<hr data-start="5507" data-end="5510">
<h2 data-start="5512" data-end="5577">2.5 Proposición útil (implicación para alineación de residuos)</h2>
