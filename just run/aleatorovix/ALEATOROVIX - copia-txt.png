double mascara_sagrada(long x, long a, long medida) {
    double dx = (double)x;
    double da = (double)a;
    if (dx <= 0) dx = 1.0;double curva = -pow(10.0, 1.0/dx) + pow(10.0, 1.0/(dx+da)) - 1.0;
return curva * (double)medida;}// --- 4. LAS CAMPANAS (Picos 0, 5, 9) ---
int pulso_gauss(int v, int p) { return (abs(v - p) <= 1); }// --- 5. EL LADRÓN (Pila y Memoria Sucia) ---
int robar_bit_pila() {
    int local; 
    return ((long)&local >> 6) & 0x01; 
}int robar_mierda_heap() {
