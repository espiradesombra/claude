    gap </span><span><span class="hljs-operator">=</span></span><span> </span><span><span class="hljs-type">L</span></span><span> </span><span><span class="hljs-operator">-</span></span><span> m
    </span><span><span class="hljs-keyword">return</span></span><span> (gap, gap </span><span><span class="hljs-operator">&gt;=</span></span><span> </span><span><span class="hljs-number">2</span></span><span>)

</span><span><span class="hljs-comment">// --- MRAUV: calibrar parámetros (D0, V0, a0) con 3 medidas observadas ---</span></span><span>
</span><span><span class="hljs-comment">// Entradas: tres puntos x0 &lt; x1 &lt; x2 con densidades observadas Dobs0, Dobs1, Dobs2</span></span><span>
</span><span><span class="hljs-comment">// Salida: params = {D0, V0, a0}</span></span><span>
</span><span><span class="hljs-comment">// Método: ajuste por diferencias finitas (asumiendo D_pred(x+Δ) = D0 + V0*Δ + 0.5 a0 Δ^2)</span></span><span>
</span><span><span class="hljs-keyword">func</span></span><span> </span><span><span class="hljs-title function_">calibrate_mrauv_from_three</span></span><span>(x0, </span><span><span class="hljs-type">Dobs0</span></span><span>, x1, </span><span><span class="hljs-type">Dobs1</span></span><span>, x2, </span><span><span class="hljs-type">Dobs2</span></span><span>):
    </span><span><span class="hljs-comment">// shift origin a x0, tratamos D(0)=D0</span></span><span>
    Δ</span><span><span class="hljs-number">1</span></span><span> </span><span><span class="hljs-operator">=</span></span><span> x1 </span><span><span class="hljs-operator">-</span></span><span> x0
    Δ</span><span><span class="hljs-number">2</span></span><span> </span><span><span class="hljs-operator">=</span></span><span> x2 </span><span><span class="hljs-operator">-</span></span><span> x0
    </span><span><span class="hljs-comment">// Sistema lineal en variables [D0, V0, a0/2]:</span></span><span>
    </span><span><span class="hljs-comment">// Dobs0 = D0</span></span><span>
    </span><span><span class="hljs-comment">// Dobs1 = D0 + V0*Δ1 + 0.5*a0*(Δ1^2)</span></span><span>
    </span><span><span class="hljs-comment">// Dobs2 = D0 + V0*Δ2 + 0.5*a0*(Δ2^2)</span></span><span>
    </span><span><span class="hljs-type">D0</span></span><span> </span><span><span class="hljs-operator">=</span></span><span> </span><span><span class="hljs-type">Dobs0</span></span><span>
    </span><span><span class="hljs-type">A</span></span><span> </span><span><span class="hljs-operator">=</span></span><span> [[Δ</span><span><span class="hljs-number">1</span></span><span>, Δ</span><span><span class="hljs-number">1</span></span><span><span class="hljs-operator">*</span></span><span>Δ</span><span><span class="hljs-number">1</span></span><span>], [Δ</span><span><span class="hljs-number">2</span></span><span>, Δ</span><span><span class="hljs-number">2</span></span><span><span class="hljs-operator">*</span></span><span>Δ</span><span><span class="hljs-number">2</span></span><span>]]  </span><span><span class="hljs-comment">// unknowns [V0, 0.5*a0]</span></span><span>
    b </span><span><span class="hljs-operator">=</span></span><span> [</span><span><span class="hljs-type">Dobs1</span></span><span> </span><span><span class="hljs-operator">-</span></span><span> </span><span><span class="hljs-type">D0</span></span><span>, </span><span><span class="hljs-type">Dobs2</span></span><span> </span><span><span class="hljs-operator">-</span></span><span> </span><span><span class="hljs-type">D0</span></span><span>]
    </span><span><span class="hljs-comment">// solve 2x2 linear system for [V0, 0.5*a0]</span></span><span>
    det </span><span><span class="hljs-operator">=</span></span><span> </span><span><span class="hljs-type">A</span></span><span>[</span><span><span class="hljs-number">0</span></span><span>][</span><span><span class="hljs-number">0</span></span><span>]</span><span><span class="hljs-operator">*</span></span><span><span class="hljs-type">A</span></span><span>[</span><span><span class="hljs-number">1</span></span><span>][</span><span><span class="hljs-number">1</span></span><span>] </span><span><span class="hljs-operator">-</span></span><span> </span><span><span class="hljs-type">A</span></span><span>[</span><span><span class="hljs-number">0</span></span><span>][</span><span><span class="hljs-number">1</span></span><span>]</span><span><span class="hljs-operator">*</span></span><span><span class="hljs-type">A</span></span><span>[</span><span><span class="hljs-number">1</span></span><span>][</span><span><span class="hljs-number">0</span></span><span>]
    </span><span><span class="hljs-keyword">if</span></span><span> </span><span><span class="hljs-built_in">abs</span></span><span>(det) </span><span><span class="hljs-operator">&lt;</span></span><span> </span><span><span class="hljs-number">1e-15</span></span><span>:
        </span><span><span class="hljs-comment">// puntos colineales o mal condicionamiento -&gt; fallback</span></span><span>
        </span><span><span class="hljs-type">V0</span></span><span> </span><span><span class="hljs-operator">=</span></span><span> (</span><span><span class="hljs-type">Dobs1</span></span><span> </span><span><span class="hljs-operator">-</span></span><span> </span><span><span class="hljs-type">D0</span></span><span>) </span><span><span class="hljs-operator">/</span></span><span> </span><span><span class="hljs-built_in">max</span></span><span>(Δ</span><span><span class="hljs-number">1</span></span><span>, </span><span><span class="hljs-number">1e-12</span></span><span>)
        a0 </span><span><span class="hljs-operator">=</span></span><span> </span><span><span class="hljs-number">0.0</span></span><span>
    </span><span><span class="hljs-keyword">else</span></span><span>:
        </span><span><span class="hljs-type">V0</span></span><span> </span><span><span class="hljs-operator">=</span></span><span> (b[</span><span><span class="hljs-number">0</span></span><span>]</span><span><span class="hljs-operator">*</span></span><span><span class="hljs-type">A</span></span><span>[</span><span><span class="hljs-number">1</span></span><span>][</span><span><span class="hljs-number">1</span></span><span>] </span><span><span class="hljs-operator">-</span></span><span> b[</span><span><span class="hljs-number">1</span></span><span>]</span><span><span class="hljs-operator">*</span></span><span><span class="hljs-type">A</span></span><span>[</span><span><span class="hljs-number">0</span></span><span>][</span><span><span class="hljs-number">1</span></span><span>]) </span><span><span class="hljs-operator">/</span></span><span> det
        half_a0 </span><span><span class="hljs-operator">=</span></span><span> (</span><span><span class="hljs-type">A</span></span><span>[</span><span><span class="hljs-number">0</span></span><span>][</span><span><span class="hljs-number">0</span></span><span>]</span><span><span class="hljs-operator">*</span></span><span>b[</span><span><span class="hljs-number">1</span></span><span>] </span><span><span class="hljs-operator">-</span></span><span> </span><span><span class="hljs-type">A</span></span><span>[</span><span><span class="hljs-number">1</span></span><span>][</span><span><span class="hljs-number">0</span></span><span>]</span><span><span class="hljs-operator">*</span></span><span>b[</span><span><span class="hljs-number">0</span></span><span>]) </span><span><span class="hljs-operator">/</span></span><span> det
        a0 </span><span><span class="hljs-operator">=</span></span><span> </span><span><span class="hljs-number">2.0</span></span><span> </span><span><span class="hljs-operator">*</span></span><span> half_a0
    </span><span><span class="hljs-keyword">return</span></span><span> (</span><span><span class="hljs-type">D0</span></span><span>, </span><span><span class="hljs-type">V0</span></span><span>, a0)

</span><span><span class="hljs-comment">// --- MRAUV: predecir densidad en [x, x+Δ] dados parámetros ---</span></span><span>
</span><span><span class="hljs-keyword">func</span></span><span> </span><span><span class="hljs-title function_">mrauv_predict</span></span><span>(</span><span><span class="hljs-type">D0</span></span><span>, </span><span><span class="hljs-type">V0</span></span><span>, a0, x_offset, Δ, use_jerk</span><span><span class="hljs-operator">=</span></span><span><span class="hljs-literal">false</span></span><span>, j0</span><span><span class="hljs-operator">=</span></span><span><span class="hljs-number">0.0</span></span><span>):
    </span><span><span class="hljs-comment">// aquí x_offset se usa solo si queremos terminos dependientes de x; </span></span><span>
    </span><span><span class="hljs-comment">// con el modelo simple usamos incremento en Δ únicamente</span></span><span>
    </span><span><span class="hljs-keyword">if</span></span><span> use_jerk:
        </span><span><span class="hljs-comment">// D_pred = D0 + V0*Δ + 0.5*a0*Δ^2 + (1/6)*j0*Δ^3</span></span><span>
        </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-type">D0</span></span><span> </span><span><span class="hljs-operator">+</span></span><span> </span><span><span class="hljs-type">V0</span></span><span><span class="hljs-operator">*</span></span><span>Δ </span><span><span class="hljs-operator">+</span></span><span> </span><span><span class="hljs-number">0.5</span></span><span><span class="hljs-operator">*</span></span><span>a0</span><span><span class="hljs-operator">*</span></span><span>(Δ</span><span><span class="hljs-operator">*</span></span><span>Δ) </span><span><span class="hljs-operator">+</span></span><span> (</span><span><span class="hljs-number">1.0</span></span><span><span class="hljs-operator">/</span></span><span><span class="hljs-number">6.0</span></span><span>)</span><span><span class="hljs-operator">*</span></span><span>j0</span><span><span class="hljs-operator">*</span></span><span>(Δ</span><span><span class="hljs-operator">*</span></span><span>Δ</span><span><span class="hljs-operator">*</span></span><span>Δ)
    </span><span><span class="hljs-keyword">else</span></span><span>:
        </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-type">D0</span></span><span> </span><span><span class="hljs-operator">+</span></span><span> </span><span><span class="hljs-type">V0</span></span><span><span class="hljs-operator">*</span></span><span>Δ </span><span><span class="hljs-operator">+</span></span><span> </span><span><span class="hljs-number">0.5</span></span><span><span class="hljs-operator">*</span></span><span>a0</span><span><span class="hljs-operator">*</span></span><span>(Δ</span><span><span class="hljs-operator">*</span></span><span>Δ)

</span><span><span class="hljs-comment">// --- GOLD BACH POR SEGMENTACIÓN ---</span></span><span>
</span><span><span class="hljs-comment">// Entrada: 2n (even), elección de Δ (por ejemplo floor(c*sqrt(n)))</span></span><span>
</span><span><span class="hljs-comment">// Necesita función para obtener D_pred en un tramo (usando MRAUV o densidad observada)</span></span><span>
</span><span><span class="hljs-comment">// Opcional: usar densidad observada por pi(x)/x si se dispone</span></span><span>
</span><span><span class="hljs-keyword">func</span></span><span> </span><span><span class="hljs-title function_">goldbach_segmented_two_n</span></span><span>(two_n, Δ, density_predictor):
    n </span><span><span class="hljs-operator">=</span></span><span> two_n </span><span><span class="hljs-operator">/</span></span><span> </span><span><span class="hljs-number">2</span></span><span>
    </span><span><span class="hljs-type">J</span></span><span> </span><span><span class="hljs-operator">=</span></span><span> floor(n </span><span><span class="hljs-operator">/</span></span><span> Δ)
    total_expected </span><span><span class="hljs-operator">=</span></span><span> </span><span><span class="hljs-number">0.0</span></span><span>
    </span><span><span class="hljs-keyword">for</span></span><span> j </span><span><span class="hljs-keyword">in</span></span><span> </span><span><span class="hljs-number">1</span></span><span><span class="hljs-operator">..</span></span><span><span class="hljs-type">J</span></span><span>:
        </span><span><span class="hljs-comment">// tramos simétricos</span></span><span>
        low_left </span><span><span class="hljs-operator">=</span></span><span> (j</span><span><span class="hljs-operator">-</span></span><span><span class="hljs-number">1</span></span><span>)</span><span><span class="hljs-operator">*</span></span><span>Δ </span><span><span class="hljs-operator">+</span></span><span> </span><span><span class="hljs-number">2</span></span><span>
        low_right </span><span><span class="hljs-operator">=</span></span><span> j</span><span><span class="hljs-operator">*</span></span><span>Δ </span><span><span class="hljs-operator">+</span></span><span> </span><span><span class="hljs-number">1</span></span><span>
        high_left </span><span><span class="hljs-operator">=</span></span><span> two_n </span><span><span class="hljs-operator">-</span></span><span> j</span><span><span class="hljs-operator">*</span></span><span>Δ </span><span><span class="hljs-operator">-</span></span><span> </span><span><span class="hljs-number">1</span></span><span>
        high_right </span><span><span class="hljs-operator">=</span></span><span> two_n </span><span><span class="hljs-operator">-</span></span><span> (j</span><span><span class="hljs-operator">-</span></span><span><span class="hljs-number">1</span></span><span>)</span><span><span class="hljs-operator">*</span></span><span>Δ </span><span><span class="hljs-operator">-</span></span><span> </span><span><span class="hljs-number">2</span></span><span>

        </span><span><span class="hljs-comment">// Obtener densidades predictas en los tramos (puede ser MRAUV con parámetros locales)</span></span><span>
        </span><span><span class="hljs-comment">// density_predictor(range_left, range_right) devuelve densidad promedio en ese tramo</span></span><span>
        </span><span><span class="hljs-type">D_low</span></span><span> </span><span><span class="hljs-operator">=</span></span><span> density_predictor(low_left, low_right)
        </span><span><span class="hljs-type">D_high</span></span><span> </span><span><span class="hljs-operator">=</span></span><span> density_predictor(high_left, high_right)

        </span><span><span class="hljs-comment">// número esperado aproximado de pares provenientes de este par de tramos:</span></span><span>
        </span><span><span class="hljs-comment">// E_j ≈ D_low * D_high * Δ  (heurístico independiente)</span></span><span>
        </span><span><span class="hljs-type">E_j</span></span><span> </span><span><span class="hljs-operator">=</span></span><span> </span><span><span class="hljs-type">D_low</span></span><span> </span><span><span class="hljs-operator">*</span></span><span> </span><span><span class="hljs-type">D_high</span></span><span> </span><span><span class="hljs-operator">*</span></span><span> Δ
        total_expected </span><span><span class="hljs-operator">+=</span></span><span> </span><span><span class="hljs-type">E_j</span></span><span>

    </span><span><span class="hljs-keyword">return</span></span><span> total_expected

</span><span><span class="hljs-comment">// --- EJEMPLO DE density_predictor usando MRAUV calibrado localmente ---</span></span><span>
</span><span><span class="hljs-comment">// Se asume que tenemos 3 mediciones locales (x0,D0),(x1,D1),(x2,D2)</span></span><span>
</span><span><span class="hljs-comment">// Podemos recalibrar por cada bloque mayor o usar una calibración global</span></span><span>
</span><span><span class="hljs-keyword">func</span></span><span> </span><span><span class="hljs-title function_">make_mrauv_density_predictor</span></span><span>(calibration_points):
    </span><span><span class="hljs-comment">// calibration_points: list of triples (x_center, Dobs) (choose 3 consecutive centers)</span></span><span>
    (x0,</span><span><span class="hljs-type">D0</span></span><span>),(x1,</span><span><span class="hljs-type">D1</span></span><span>),(x2,</span><span><span class="hljs-type">D2</span></span><span>) </span><span><span class="hljs-operator">=</span></span><span> select_three(calibration_points)
    (</span><span><span class="hljs-type">D0c</span></span><span>, </span><span><span class="hljs-type">V0c</span></span><span>, a0c) </span><span><span class="hljs-operator">=</span></span><span> calibrate_mrauv_from_three(x0, </span><span><span class="hljs-type">D0</span></span><span>, x1, </span><span><span class="hljs-type">D1</span></span><span>, x2, </span><span><span class="hljs-type">D2</span></span><span>)
    </span><span><span class="hljs-keyword">return</span></span><span> function(range_left, range_right):
        </span><span><span class="hljs-comment">// usar centro del tramo como Δ desde x0</span></span><span>
        x_center </span><span><span class="hljs-operator">=</span></span><span> (range_left </span><span><span class="hljs-operator">+</span></span><span> range_right) </span><span><span class="hljs-operator">/</span></span><span> </span><span><span class="hljs-number">2.0</span></span><span>
        Δ </span><span><span class="hljs-operator">=</span></span><span> x_center </span><span><span class="hljs-operator">-</span></span><span> x0
        pred </span><span><span class="hljs-operator">=</span></span><span> mrauv_predict(</span><span><span class="hljs-type">D0c</span></span><span>, </span><span><span class="hljs-type">V0c</span></span><span>, a0c, x_center </span><span><span class="hljs-operator">-</span></span><span> x0, Δ, use_jerk</span><span><span class="hljs-operator">=</span></span><span><span class="hljs-literal">false</span></span><span>)
        </span><span><span class="hljs-comment">// asegurar pred non-negative</span></span><span>
        </span><span><span class="hljs-keyword">if</span></span><span> pred </span><span><span class="hljs-operator">&lt;</span></span><span> </span><span><span class="hljs-number">0</span></span><span>: pred </span><span><span class="hljs-operator">=</span></span><span> </span><span><span class="hljs-number">0.0</span></span><span>
        </span><span><span class="hljs-keyword">return</span></span><span> pred

</span><span><span class="hljs-comment">// --- EJECUCIÓN EJEMPLO ---</span></span><span>
</span><span><span class="hljs-comment">// Entrada: n (ej: 10^6), c para Δ (ej: 1.0)</span></span><span>
</span><span><span class="hljs-keyword">func</span></span><span> </span><span><span class="hljs-title function_">main_example</span></span><span>(n, c</span><span><span class="hljs-operator">=</span></span><span><span class="hljs-number">1.0</span></span><span>, use_m_approx</span><span><span class="hljs-operator">=</span></span><span><span class="hljs-literal">true</span></span><span>):
    two_n </span><span><span class="hljs-operator">=</span></span><span> </span><span><span class="hljs-number">2</span></span><span><span class="hljs-operator">*</span></span><span>n
    Δ </span><span><span class="hljs-operator">=</span></span><span> floor(c </span><span><span class="hljs-operator">*</span></span><span> sqrt(n))
    </span><span><span class="hljs-comment">// 1) comprobar gap</span></span><span>
    (gap, ok) </span><span><span class="hljs-operator">=</span></span><span> check_gap(n, use_approx</span><span><span class="hljs-operator">=</span></span><span>use_m_approx)
    </span><span><span class="hljs-built_in">print</span></span><span>(</span><span><span class="hljs-string">"n="</span></span><span>, n, </span><span><span class="hljs-string">"L-m gap="</span></span><span>, gap, </span><span><span class="hljs-string">"meets criterion:"</span></span><span>, ok)

    </span><span><span class="hljs-comment">// 2) crear predictor (aquí se debe proporcionar densidades observadas; en ejemplo usaremos D0 ~ 1/log x)</span></span><span>
    </span><span><span class="hljs-comment">// Nota: en implementación real reemplazar por pi(x)/x muestreado o por una criba local</span></span><span>
    </span><span><span class="hljs-comment">// ejemplo heurístico de densidad</span></span><span>
    calibration_points </span><span><span class="hljs-operator">=</span></span><span> [
        (n </span><span><span class="hljs-operator">-</span></span><span> </span><span><span class="hljs-number">2</span></span><span><span class="hljs-operator">*</span></span><span>Δ, </span><span><span class="hljs-number">1.0</span></span><span><span class="hljs-operator">/</span></span><span>log(</span><span><span class="hljs-built_in">max</span></span><span>(</span><span><span class="hljs-number">2</span></span><span>, n </span><span><span class="hljs-operator">-</span></span><span> </span><span><span class="hljs-number">2</span></span><span><span class="hljs-operator">*</span></span><span>Δ))),
        (n,       </span><span><span class="hljs-number">1.0</span></span><span><span class="hljs-operator">/</span></span><span>log(</span><span><span class="hljs-built_in">max</span></span><span>(</span><span><span class="hljs-number">2</span></span><span>, n))),
        (n </span><span><span class="hljs-operator">+</span></span><span> </span><span><span class="hljs-number">2</span></span><span><span class="hljs-operator">*</span></span><span>Δ, </span><span><span class="hljs-number">1.0</span></span><span><span class="hljs-operator">/</span></span><span>log(</span><span><span class="hljs-built_in">max</span></span><span>(</span><span><span class="hljs-number">2</span></span><span>, n </span><span><span class="hljs-operator">+</span></span><span> </span><span><span class="hljs-number">2</span></span><span><span class="hljs-operator">*</span></span><span>Δ)))
    ]
    density_predictor </span><span><span class="hljs-operator">=</span></span><span> make_mrauv_density_predictor(calibration_points)

    </span><span><span class="hljs-comment">// 3) calcular expectativa Goldbach</span></span><span>
    total_expected </span><span><span class="hljs-operator">=</span></span><span> goldbach_segmented_two_n(two_n, Δ, density_predictor)
    </span><span><span class="hljs-built_in">print</span></span><span>(</span><span><span class="hljs-string">"Total expected Goldbach representations (heuristic) ≈"</span></span><span>, total_expected)

    </span><span><span class="hljs-comment">// 4) Interpretación</span></span><span>
    </span><span><span class="hljs-keyword">if</span></span><span> total_expected </span><span><span class="hljs-operator">&gt;=</span></span><span> </span><span><span class="hljs-number">1.0</span></span><span>:
        </span><span><span class="hljs-built_in">print</span></span><span>(</span><span><span class="hljs-string">"Heurísticamente esperamos al menos una pareja p+q=2n"</span></span><span>)
    </span><span><span class="hljs-keyword">else</span></span><span>:
        </span><span><span class="hljs-built_in">print</span></span><span>(</span><span><span class="hljs-string">"Esperanza &lt; 1 — no garantiza representación"</span></span><span>)

</span></span></code></div></div></pre>
<hr data-start="12896" data-end="12899">
<h3 data-start="12901" data-end="12955">Notas prácticas sobre implementación y complejidad</h3>
<ul data-start="12957" data-end="13783">
<li data-start="12957" data-end="13198">
<p data-start="12959" data-end="13198"><code data-start="12959" data-end="12976">compute_m_exact</code> suma términos hasta <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>K</mi></mrow><annotation encoding="application/x-tex">K</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 0.6833em;"></span><span class="mord mathnormal" style="margin-right: 0.07153em;">K</span></span></span></span> o hasta que el término sea menor que la tolerancia; su coste es <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>O</mi><mo stretchy="false">(</mo><mi>K</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">O(K)</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 1em; vertical-align: -0.25em;"></span><span class="mord mathnormal" style="margin-right: 0.02778em;">O</span><span class="mopen">(</span><span class="mord mathnormal" style="margin-right: 0.07153em;">K</span><span class="mclose">)</span></span></span></span> donde <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>K</mi><mo>∼</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">(</mo><msqrt><mi>n</mi></msqrt><mo stretchy="false">)</mo><mo>⋅</mo><mi>c</mi><mi>o</mi><mi>n</mi><mi>s</mi><mi>t</mi></mrow><annotation encoding="application/x-tex">K\sim\Theta(\sqrt{n})\cdot const</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 0.6833em;"></span><span class="mord mathnormal" style="margin-right: 0.07153em;">K</span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">∼</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 1.0503em; vertical-align: -0.25em;"></span><span class="mord">Θ</span><span class="mopen">(</span><span class="mord sqrt"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height: 0.8003em;"><span class="svg-align" style="top: -3em;"><span class="pstrut" style="height: 3em;"></span><span class="mord" style="padding-left: 0.833em;"><span class="mord mathnormal">n</span></span></span><span style="top: -2.7603em;"><span class="pstrut" style="height: 3em;"></span><span class="hide-tail" style="min-width: 0.853em; height: 1.08em;"><svg xmlns="http://www.w3.org/2000/svg" width="400em" height="1.08em" viewBox="0 0 400000 1080" preserveAspectRatio="xMinYMin slice"><path d="M95,702
