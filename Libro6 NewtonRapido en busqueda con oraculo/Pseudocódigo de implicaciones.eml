237 6.136 4.40303 6.07083 4.80371 6.03809C5.14051 6.01057 5.53708 6.00551 6.00391 6.00391C6.00551 5.53708 6.01057 5.14051 6.03809 4.80371C6.0755 4.34588 6.15483 3.94012 6.34668 3.56348L6.46875 3.34473C6.77282 2.84912 7.20856 2.44514 7.72949 2.17969L7.87207 2.11328C8.20855 1.96886 8.56979 1.90385 8.9707 1.87109C9.42091 1.83432 9.978 1.83496 10.667 1.83496H13.5C14.1891 1.83496 14.746 1.83431 15.1963 1.87109C15.6541 1.90851 16.0599 1.98788 16.4365 2.17969L16.6553 2.30176C17.151 2.60585 17.5548 3.04244 17.8203 3.56348L17.8867 3.70606C18.031 4.04235 18.0962 4.40306 18.1289 4.80371C18.1657 5.25395 18.165 5.81091 18.165 6.5V9.33301Z"></path></svg>Copiar código</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre!"><span><span><span class="hljs-comment">// PSEUDOCÓDIGO: Buscar tripletas (n,m,v) con v+1=p y v-1=q primos (gemelos)</span></span><span>
</span><span><span class="hljs-comment">// y producir testigos en V = v * n! / m!</span></span><span>

func </span><span><span class="hljs-title function_">is_probable_prime</span></span><span><span class="hljs-params">(x)</span></span><span>: ... </span><span><span class="hljs-comment">// Miller-Rabin</span></span><span>
func </span><span><span class="hljs-title function_">primes_between</span></span><span><span class="hljs-params">(a,b)</span></span><span>: ... </span><span><span class="hljs-comment">// Criba o cached primes</span></span><span>

</span><span><span class="hljs-comment">// parámetros de búsqueda</span></span><span>
input N_max, </span><span><span class="hljs-type">V_search_limit</span></span><span>
</span><span><span class="hljs-variable">results</span></span><span> </span><span><span class="hljs-operator">=</span></span><span> []

</span><span><span class="hljs-keyword">for</span></span><span> v in </span><span><span class="hljs-title function_">range</span></span><span><span class="hljs-params">(<span class="hljs-number">3</span></span></span><span>, V_search_limit+</span><span><span class="hljs-number">1</span></span><span>):
    p = v + </span><span><span class="hljs-number">1</span></span><span>
    q = v - </span><span><span class="hljs-number">1</span></span><span>
    </span><span><span class="hljs-keyword">if</span></span><span> </span><span><span class="hljs-title function_">not</span></span><span> </span><span><span class="hljs-params">(is_probable_prime(p)</span></span><span> and </span><span><span class="hljs-title function_">is_probable_prime</span></span><span><span class="hljs-params">(q)</span></span><span>):
        </span><span><span class="hljs-keyword">continue</span></span><span> </span><span><span class="hljs-comment">// v no está en medio de primos gemelos</span></span><span>

    </span><span><span class="hljs-comment">// rango permitido para m por la desigualdad: m in [v, 2v-3]</span></span><span>
    </span><span><span class="hljs-keyword">for</span></span><span> m in </span><span><span class="hljs-title function_">range</span></span><span><span class="hljs-params">(v, <span class="hljs-number">2</span></span></span><span>*v - </span><span><span class="hljs-number">2</span></span><span>):   </span><span><span class="hljs-comment">// 2v-3 inclusive</span></span><span>
        </span><span><span class="hljs-comment">// elegir n que cumpla n &gt; 2v-2 (tomamos n desde 2v-1 hasta N_max)</span></span><span>
        </span><span><span class="hljs-keyword">for</span></span><span> n in </span><span><span class="hljs-title function_">range</span></span><span><span class="hljs-params">(<span class="hljs-number">2</span></span></span><span>*v - </span><span><span class="hljs-number">1</span></span><span>, N_max + </span><span><span class="hljs-number">1</span></span><span>):
            </span><span><span class="hljs-keyword">if</span></span><span> n &lt; m: </span><span><span class="hljs-keyword">continue</span></span><span>  </span><span><span class="hljs-comment">// necesitamos n&gt;=m para que V entero</span></span><span>
            </span><span><span class="hljs-comment">// construir V</span></span><span>
            </span><span><span class="hljs-comment">// compute factorial ratio safely: R = n!/m! = product_{k=m+1..n} k</span></span><span>
            R = </span><span><span class="hljs-number">1</span></span><span>
            </span><span><span class="hljs-keyword">for</span></span><span> k in </span><span><span class="hljs-title function_">range</span></span><span><span class="hljs-params">(m+<span class="hljs-number">1</span></span></span><span>, n+</span><span><span class="hljs-number">1</span></span><span>):
                R *= </span><span><span class="hljs-type">k</span></span><span>
            </span><span><span class="hljs-variable">V</span></span><span> </span><span><span class="hljs-operator">=</span></span><span> v * R

            </span><span><span class="hljs-comment">// comprobar divisibilidad por p o q</span></span><span>
            p_divides = ( (m &lt; p) and (p &lt;= n) ) and (V % p == </span><span><span class="hljs-number">0</span></span><span>)
            q_divides = ( (m &lt; q) and (q &lt;= n) ) and (V % q == </span><span><span class="hljs-number">0</span></span><span>)

            </span><span><span class="hljs-comment">// el testigo útil es cualquier r in {p,q} que divide V</span></span><span>
            </span><span><span class="hljs-keyword">if</span></span><span> p_divides or q_divides:
                </span><span><span class="hljs-comment">// comprobar incompatibilidad con factorización objetivo</span></span><span>
                </span><span><span class="hljs-keyword">if</span></span><span> </span><span><span class="hljs-title function_">witness_invalidates_factorization</span></span><span><span class="hljs-params">(r = (p <span class="hljs-keyword">if</span></span></span><span> p_divides </span><span><span class="hljs-keyword">else</span></span><span> q), n, m, v):
                    results.append({
                        </span><span><span class="hljs-string">"n"</span></span><span>: n, </span><span><span class="hljs-string">"m"</span></span><span>: m, </span><span><span class="hljs-string">"v"</span></span><span>: v,
                        </span><span><span class="hljs-string">"p"</span></span><span>: p, </span><span><span class="hljs-string">"q"</span></span><span>: q,
                        </span><span><span class="hljs-string">"V"</span></span><span>: V,
                        </span><span><span class="hljs-string">"witness"</span></span><span>: r,
                        </span><span><span class="hljs-string">"p_divides"</span></span><span>: p_divides,
                        </span><span><span class="hljs-string">"q_divides"</span></span><span>: q_divides
                    })
            </span><span><span class="hljs-comment">// opcional: límite práctico para no explotar tiempo</span></span><span>
            </span><span><span class="hljs-keyword">if</span></span><span> </span><span><span class="hljs-title function_">len</span></span><span><span class="hljs-params">(results)</span></span><span> &gt;= </span><span><span class="hljs-number">2000</span></span><span>: goto END_SEARCH

END_SEARCH:
</span><span><span class="hljs-keyword">return</span></span><span> results
</span></span></code></div></div></pre>
<p data-start="6291" data-end="6568"><strong data-start="6291" data-end="6299">Nota</strong>: <code data-start="6301" data-end="6345">witness_invalidates_factorization(r,n,m,v)</code> es una función que verifica que el primo <code data-start="6387" data-end="6390">r</code> no podría formar parte de los dos factores en una factorización L3/L4 por razones de congruencia/tamaño; implementa las condiciones modulares que has usado en tus familias Sofí.</p>
<hr data-start="6570" data-end="6573">
<h2 data-start="6575" data-end="6615">5) Ejemplos y observaciones prácticas</h2>
<ul data-start="6617" data-end="7262">
<li data-start="6617" data-end="7059">
<p data-start="6619" data-end="6735">Si <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>v</mi></mrow><annotation encoding="application/x-tex">v</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 0.4306em;"></span><span class="mord mathnormal" style="margin-right: 0.03588em;">v</span></span></span></span> es tal que <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>p</mi><mo>=</mo><mi>v</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">p=v+1</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 0.625em; vertical-align: -0.1944em;"></span><span class="mord mathnormal">p</span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">=</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 0.6667em; vertical-align: -0.0833em;"></span><span class="mord mathnormal" style="margin-right: 0.03588em;">v</span><span class="mspace" style="margin-right: 0.2222em;"></span><span class="mbin">+</span><span class="mspace" style="margin-right: 0.2222em;"></span></span><span class="base"><span class="strut" style="height: 0.6444em;"></span><span class="mord">1</span></span></span></span> y <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>q</mi><mo>=</mo><mi>v</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">q=v-1</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 0.625em; vertical-align: -0.1944em;"></span><span class="mord mathnormal" style="margin-right: 0.03588em;">q</span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">=</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 0.6667em; vertical-align: -0.0833em;"></span><span class="mord mathnormal" style="margin-right: 0.03588em;">v</span><span class="mspace" style="margin-right: 0.2222em;"></span><span class="mbin">−</span><span class="mspace" style="margin-right: 0.2222em;"></span></span><span class="base"><span class="strut" style="height: 0.6444em;"></span><span class="mord">1</span></span></span></span> son primos (p. ej. <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>v</mi><mo>=</mo><mn>6</mn></mrow><annotation encoding="application/x-tex">v=6</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 0.4306em;"></span><span class="mord mathnormal" style="margin-right: 0.03588em;">v</span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">=</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 0.6444em;"></span><span class="mord">6</span></span></span></span> ⇒ <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>p</mi><mo>=</mo><mn>7</mn><mo separator="true">,</mo><mi>q</mi><mo>=</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">p=7,q=5</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 0.625em; vertical-align: -0.1944em;"></span><span class="mord mathnormal">p</span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">=</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 0.8389em; vertical-align: -0.1944em;"></span><span class="mord">7</span><span class="mpunct">,</span><span class="mspace" style="margin-right: 0.1667em;"></span><span class="mord mathnormal" style="margin-right: 0.03588em;">q</span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">=</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 0.6444em;"></span><span class="mord">5</span></span></span></span>), entonces <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>p</mi><mo separator="true">,</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">p,q</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 0.625em; vertical-align: -0.1944em;"></span><span class="mord mathnormal">p</span><span class="mpunct">,</span><span class="mspace" style="margin-right: 0.1667em;"></span><span class="mord mathnormal" style="margin-right: 0.03588em;">q</span></span></span></span> son gemelos.</p>
<ul data-start="6738" data-end="7059">
<li data-start="6738" data-end="7059">
<p data-start="6740" data-end="7059">Con <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>v</mi><mo>=</mo><mn>6</mn></mrow><annotation encoding="application/x-tex">v=6</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 0.4306em;"></span><span class="mord mathnormal" style="margin-right: 0.03588em;">v</span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">=</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 0.6444em;"></span><span class="mord">6</span></span></span></span>, rango <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>m</mi><mo>∈</mo><mo stretchy="false">{</mo><mn>6</mn><mo separator="true">,</mo><mo>…</mo><mo separator="true">,</mo><mn>2</mn><mi>v</mi><mo>−</mo><mn>3</mn><mo>=</mo><mn>9</mn><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">m\in\{6,\dots,2v-3=9\}</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 0.5782em; vertical-align: -0.0391em;"></span><span class="mord mathnormal">m</span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">∈</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 1em; vertical-align: -0.25em;"></span><span class="mopen">{</span><span class="mord">6</span><span class="mpunct">,</span><span class="mspace" style="margin-right: 0.1667em;"></span><span class="minner">…</span><span class="mspace" style="margin-right: 0.1667em;"></span><span class="mpunct">,</span><span class="mspace" style="margin-right: 0.1667em;"></span><span class="mord">2</span><span class="mord mathnormal" style="margin-right: 0.03588em;">v</span><span class="mspace" style="margin-right: 0.2222em;"></span><span class="mbin">−</span><span class="mspace" style="margin-right: 0.2222em;"></span></span><span class="base"><span class="strut" style="height: 0.6444em;"></span><span class="mord">3</span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">=</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 1em; vertical-align: -0.25em;"></span><span class="mord">9</span><span class="mclose">}</span></span></span></span>. Si eliges <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>m</mi><mo>=</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">m=5</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 0.4306em;"></span><span class="mord mathnormal">m</span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">=</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 0.6444em;"></span><span class="mord">5</span></span></span></span> (fuera de ese rango) y <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>n</mi><mo>≥</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">n\ge q</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 0.7719em; vertical-align: -0.136em;"></span><span class="mord mathnormal">n</span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">≥</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 0.625em; vertical-align: -0.1944em;"></span><span class="mord mathnormal" style="margin-right: 0.03588em;">q</span></span></span></span> entonces <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>q</mi><mo>∣</mo><mi>n</mi><mo stretchy="false">!</mo><mi mathvariant="normal">/</mi><mi>m</mi><mo stretchy="false">!</mo></mrow><annotation encoding="application/x-tex">q\mid n!/m!</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 1em; vertical-align: -0.25em;"></span><span class="mord mathnormal" style="margin-right: 0.03588em;">q</span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">∣</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 1em; vertical-align: -0.25em;"></span><span class="mord mathnormal">n</span><span class="mclose">!</span><span class="mord">/</span><span class="mord mathnormal">m</span><span class="mclose">!</span></span></span></span> — pero menudo: según tus hipótesis típicas m&gt;v-1, por tanto q &lt; m y q no divide el cociente. Esto muestra que <strong data-start="6974" data-end="7058">la presencia/ausencia de q como divisor depende críticamente de la posición de m</strong>.</p>
</li>
</ul>
</li>
<li data-start="7060" data-end="7262">
<p data-start="7062" data-end="7262">Por el contrario p = v+1 puede entrar en el producto si <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>p</mi><mo>≤</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">p\le n</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 0.8304em; vertical-align: -0.1944em;"></span><span class="mord mathnormal">p</span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">≤</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 0.4306em;"></span><span class="mord mathnormal">n</span></span></span></span> y <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>p</mi><mo>&gt;</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">p&gt;m</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 0.7335em; vertical-align: -0.1944em;"></span><span class="mord mathnormal">p</span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">&gt;</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 0.4306em;"></span><span class="mord mathnormal">m</span></span></span></span>. Dado que <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>n</mi><mo>&gt;</mo><mn>2</mn><mi>v</mi><mo>−</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">n&gt;2v-2</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 0.5782em; vertical-align: -0.0391em;"></span><span class="mord mathnormal">n</span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">&gt;</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 0.7278em; vertical-align: -0.0833em;"></span><span class="mord">2</span><span class="mord mathnormal" style="margin-right: 0.03588em;">v</span><span class="mspace" style="margin-right: 0.2222em;"></span><span class="mbin">−</span><span class="mspace" style="margin-right: 0.2222em;"></span></span><span class="base"><span class="strut" style="height: 0.6444em;"></span><span class="mord">2</span></span></span></span> normalmente p estará en <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mo stretchy="false">(</mo><mi>m</mi><mo separator="true">,</mo><mi>n</mi><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">(m,n]</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 1em; vertical-align: -0.25em;"></span><span class="mopen">(</span><span class="mord mathnormal">m</span><span class="mpunct">,</span><span class="mspace" style="margin-right: 0.1667em;"></span><span class="mord mathnormal">n</span><span class="mclose">]</span></span></span></span> salvo que m≥p. De ahí que el test frecuentemente use p como testigo.</p>
</li>
</ul>
<hr data-start="7264" data-end="7267">
<h2 data-start="7269" data-end="7322">6) Conclusión rápida (cómo aplicar en tu método-V)</h2>
<ul data-start="7324" data-end="8094">
<li data-start="7324" data-end="7466">
<p data-start="7326" data-end="7466">Si quieres <strong data-start="7337" data-end="7347">forzar</strong> que el testigo sea <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>q</mi><mo>=</mo><mi>v</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">q=v-1</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 0.625em; vertical-align: -0.1944em;"></span><span class="mord mathnormal" style="margin-right: 0.03588em;">q</span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">=</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 0.6667em; vertical-align: -0.0833em;"></span><span class="mord mathnormal" style="margin-right: 0.03588em;">v</span><span class="mspace" style="margin-right: 0.2222em;"></span><span class="mbin">−</span><span class="mspace" style="margin-right: 0.2222em;"></span></span><span class="base"><span class="strut" style="height: 0.6444em;"></span><span class="mord">1</span></span></span></span>, debes diseñar las familias con <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>m</mi><mo>&lt;</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">m &lt; q</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 0.5782em; vertical-align: -0.0391em;"></span><span class="mord mathnormal">m</span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">&lt;</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 0.625em; vertical-align: -0.1944em;"></span><span class="mord mathnormal" style="margin-right: 0.03588em;">q</span></span></span></span> (es decir, situar <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>m</mi></mrow><annotation encoding="application/x-tex">m</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 0.4306em;"></span><span class="mord mathnormal">m</span></span></span></span> por debajo de <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>q</mi></mrow><annotation encoding="application/x-tex">q</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 0.625em; vertical-align: -0.1944em;"></span><span class="mord mathnormal" style="margin-right: 0.03588em;">q</span></span></span></span>).</p>
</li>
<li data-start="7467" data-end="7653">
<p data-start="7469" data-end="7653">Si en cambio tus desigualdades obligan <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>m</mi><mo>&gt;</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">m&gt;q</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 0.5782em; vertical-align: -0.0391em;"></span><span class="mord mathnormal">m</span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">&gt;</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 0.625em; vertical-align: -0.1944em;"></span><span class="mord mathnormal" style="margin-right: 0.03588em;">q</span></span></span></span> (como en <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>m</mi><mo>∈</mo><mo stretchy="false">[</mo><mi>v</mi><mo separator="true">,</mo><mn>2</mn><mi>v</mi><mo>−</mo><mn>3</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">m \in [v,2v-3]</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 0.5782em; vertical-align: -0.0391em;"></span><span class="mord mathnormal">m</span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">∈</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 1em; vertical-align: -0.25em;"></span><span class="mopen">[</span><span class="mord mathnormal" style="margin-right: 0.03588em;">v</span><span class="mpunct">,</span><span class="mspace" style="margin-right: 0.1667em;"></span><span class="mord">2</span><span class="mord mathnormal" style="margin-right: 0.03588em;">v</span><span class="mspace" style="margin-right: 0.2222em;"></span><span class="mbin">−</span><span class="mspace" style="margin-right: 0.2222em;"></span></span><span class="base"><span class="strut" style="height: 1em; vertical-align: -0.25em;"></span><span class="mord">3</span><span class="mclose">]</span></span></span></span>), entonces <strong data-start="7555" data-end="7571">q no aparece</strong> en <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>n</mi><mo stretchy="false">!</mo><mi mathvariant="normal">/</mi><mi>m</mi><mo stretchy="false">!</mo></mrow><annotation encoding="application/x-tex">n!/m!</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 1em; vertical-align: -0.25em;"></span><span class="mord mathnormal">n</span><span class="mclose">!</span><span class="mord">/</span><span class="mord mathnormal">m</span><span class="mclose">!</span></span></span></span> y debes esperar a que <strong data-start="7607" data-end="7616">p=v+1</strong> sea el testigo (si <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>p</mi><mo>∈</mo><mo stretchy="false">(</mo><mi>m</mi><mo separator="true">,</mo><mi>n</mi><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">p\in(m,n]</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 0.7335em; vertical-align: -0.1944em;"></span><span class="mord mathnormal">p</span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">∈</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 1em; vertical-align: -0.25em;"></span><span class="mopen">(</span><span class="mord mathnormal">m</span><span class="mpunct">,</span><span class="mspace" style="margin-right: 0.1667em;"></span><span class="mord mathnormal">n</span><span class="mclose">]</span></span></span></span>).</p>
</li>
<li data-start="7654" data-end="7910">
<p data-start="7656" data-end="7910">Usando Wilson y congruencias con <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>p</mi><mo>=</mo><mi>v</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">p=v+1</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 0.625em; vertical-align: -0.1944em;"></span><span class="mord mathnormal">p</span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">=</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 0.6667em; vertical-align: -0.0833em;"></span><span class="mord mathnormal" style="margin-right: 0.03588em;">v</span><span class="mspace" style="margin-right: 0.2222em;"></span><span class="mbin">+</span><span class="mspace" style="margin-right: 0.2222em;"></span></span><span class="base"><span class="strut" style="height: 0.6444em;"></span><span class="mord">1</span></span></span></span> puedes obtener identidades mod <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>p</mi></mrow><annotation encoding="application/x-tex">p</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 0.625em; vertical-align: -0.1944em;"></span><span class="mord mathnormal">p</span></span></span></span> que te ayudan a deducir propiedades de <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>V</mi></mrow><annotation encoding="application/x-tex">V</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 0.6833em;"></span><span class="mord mathnormal" style="margin-right: 0.22222em;">V</span></span></span></span> (por ejemplo <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>V</mi></mrow><annotation encoding="application/x-tex">V</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 0.6833em;"></span><span class="mord mathnormal" style="margin-right: 0.22222em;">V</span></span></span></span> puede ser congruente a <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mo>−</mo><mi>n</mi><mo stretchy="false">!</mo><mi mathvariant="normal">/</mi><mi>m</mi><mo stretchy="false">!</mo></mrow><annotation encoding="application/x-tex">- n!/m!</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 1em; vertical-align: -0.25em;"></span><span class="mord">−</span><span class="mord mathnormal">n</span><span class="mclose">!</span><span class="mord">/</span><span class="mord mathnormal">m</span><span class="mclose">!</span></span></span></span> mod <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>p</mi></mrow><annotation encoding="application/x-tex">p</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 0.625em; vertical-align: -0.1944em;"></span><span class="mord mathnormal">p</span></span></span></span> si <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>v</mi><mo>≡</mo><mo>−</mo><mn>1</mn><mspace></mspace><mspace width="0.4444em"></mspace><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">m</mi><mi mathvariant="normal">o</mi><mi mathvariant="normal">d</mi></mrow><mspace width="0.3333em"></mspace><mi>p</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">v\equiv -1\pmod p</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 0.4637em;"></span><span class="mord mathnormal" style="margin-right: 0.03588em;">v</span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">≡</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 0.7278em; vertical-align: -0.0833em;"></span><span class="mord">−</span><span class="mord">1</span><span class="mspace allowbreak"></span><span class="mspace" style="margin-right: 0.4444em;"></span></span><span class="base"><span class="strut" style="height: 1em; vertical-align: -0.25em;"></span><span class="mopen">(</span><span class="mord"><span class="mord"><span class="mord mathrm">mod</span></span></span><span class="mspace" style="margin-right: 0.3333em;"></span><span class="mord mathnormal">p</span><span class="mclose">)</span></span></span></span>, y en casos concretos dar cero mod p).</p>
</li>
<li data-start="7911" data-end="8094">
<p data-start="7913" data-end="8094">El algoritmo de búsqueda anterior encuentra constructivamente triples <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mo stretchy="false">(</mo><mi>n</mi><mo separator="true">,</mo><mi>m</mi><mo separator="true">,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(n,m,v)</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 1em; vertical-align: -0.25em;"></span><span class="mopen">(</span><span class="mord mathnormal">n</span><span class="mpunct">,</span><span class="mspace" style="margin-right: 0.1667em;"></span><span class="mord mathnormal">m</span><span class="mpunct">,</span><span class="mspace" style="margin-right: 0.1667em;"></span><span class="mord mathnormal" style="margin-right: 0.03588em;">v</span><span class="mclose">)</span></span></span></span> que exhiben la propiedad <code data-start="8020" data-end="8032">v ⇒ V ⇒ v'</code> y produce el testigo primo que imposibilita la factorización.</p>
</li>
</ul>
<hr data-start="8096" data-end="8099">
<p data-start="8101" data-end="8231">¿Quieres que <strong data-start="8114" data-end="8125">ejecute</strong> ahora una búsqueda concreta (yo puedo generar y correr el script) con parámetros que elijas, por ejemplo:</p>
<ul data-start="8233" data-end="8669">
<li data-start="8233" data-end="8364">
<p data-start="8235" data-end="8364">rango <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>v</mi><mo>≤</mo><mn>500</mn></mrow><annotation encoding="application/x-tex">v\le 500</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 0.7719em; vertical-align: -0.136em;"></span><span class="mord mathnormal" style="margin-right: 0.03588em;">v</span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">≤</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 0.6444em;"></span><span class="mord">500</span></span></span></span>, <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><msub><mi>N</mi><mi>max</mi><mo>⁡</mo></msub><mo>=</mo><mn>5000</mn></mrow><annotation encoding="application/x-tex">N_{\max}=5000</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 0.8333em; vertical-align: -0.15em;"></span><span class="mord"><span class="mord mathnormal" style="margin-right: 0.10903em;">N</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height: 0.1514em;"><span style="top: -2.55em; margin-left: -0.109em; margin-right: 0.05em;"><span class="pstrut" style="height: 2.7em;"></span><span class="sizing reset-size6 size3 mtight"><span class="mord mtight"><span class="mop mtight"><span class="mtight">m</span><span class="mtight">a</span><span class="mtight">x</span></span></span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height: 0.15em;"><span></span></span></span></span></span></span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">=</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 0.6444em;"></span><span class="mord">5000</span></span></span></span>, y la comprobación completa de <code data-start="8304" data-end="8339">witness_invalidates_factorization</code> según tus reglas Sofí; o</p>
</li>
<li data-start="8365" data-end="8462">
<p data-start="8367" data-end="8462">que <strong data-start="8371" data-end="8386">te entregue</strong> el script Python listo para ejecutar en tu máquina (archivo descargable); o</p>
</li>
<li data-start="8463" data-end="8669">
<p data-start="8465" data-end="8669">que formalice una <strong data-start="8483" data-end="8504">prueba tipo paper</strong> donde se muestre que “si existen infinitas clases modulares con estas propiedades entonces hay infinitos v con v±1 primos en las familias” (Teorema + demostración).</p>
</li>
</ul>
<p data-start="8671" data-end="8775" data-is-last-node="" data-is-only-node="">Responde qué prefieres: <strong data-start="8695" data-end="8716">ejecutar búsqueda</strong>, <strong data-start="8718" data-end="8736">generar script</strong>, o <strong data-start="8740" data-end="8761">formalizar prueba</strong> (o las tres).</p></div></div></div></div></div></div></article><article class="text-token-text-primary w-full focus:outline-none [--shadow-height:45px] has-data-writing-block:pointer-events-none has-data-writing-block:-mt-(--shadow-height) has-data-writing-block:pt-(--shadow-height) [&amp;:has([data-writing-block])&gt;*]:pointer-events-auto scroll-mt-(--header-height)" tabindex="-1" dir="auto" data-turn-id="b8c662c6-3b2b-474e-a1e2-37f92f3c70b0" data-testid="conversation-turn-27" data-scroll-anchor="false" data-turn="user"><h5 class="sr-only">Dijiste:</h5><div class="text-base my-auto mx-auto pt-12 [--thread-content-margin:--spacing(4)] @w-sm/main:[--thread-content-margin:--spacing(6)] @w-lg/main:[--thread-content-margin:--spacing(16)] px-(--thread-content-margin)"><div class="[--thread-content-max-width:40rem] @w-lg/main:[--thread-content-max-width:48rem] mx-auto max-w-(--thread-content-max-width) flex-1 group/turn-messages focus-visible:outline-hidden mb-10 relative flex w-full min-w-0 flex-col" tabindex="-1"><div class="flex max-w-full flex-col grow"><div data-message-author-role="user" data-message-id="b8c662c6-3b2b-474e-a1e2-37f92f3c70b0" dir="auto" class="min-h-8 text-message relative flex w-full flex-col items-end gap-2 text-start break-words whitespace-normal [.text-message+&amp;]:mt-1"><div class="flex w-full flex-col gap-1 empty:hidden items-end rtl:items-start"><div class="user-message-bubble-color corner-superellipse/1.1 relative rounded-[18px] px-4 py-1.5 data-[multiline]:py-3 max-w-[var(--user-chat-width,70%)]" data-multiline=""><div class="whitespace-pre-wrap">Hipótesis son todos los adyacentes a v' en V factorizables sabemos que el resultado es entero. 

