    SI n mod </span><span><span class="hljs-number">6</span></span><span> != </span><span><span class="hljs-number">5</span></span><span>:
        RETORNAR </span><span><span class="hljs-string">"fuera de L1"</span></span><span>

    </span><span><span class="hljs-comment">// pertenece a L1</span></span><span>
    en_L1 = VERDADERO

    </span><span><span class="hljs-comment">// L3: factor de tipo (6k−1)(6h+1)</span></span><span>
    SI existe k,h tales </span><span><span class="hljs-type">que</span></span><span> </span><span><span class="hljs-variable">n</span></span><span> </span><span><span class="hljs-operator">=</span></span><span> (6k−</span><span><span class="hljs-number">1</span></span><span>)(6h+</span><span><span class="hljs-number">1</span></span><span>):
        en_L3 = VERDADERO
    SINO:
        en_L3 = FALSO

    </span><span><span class="hljs-comment">// L4: 2n+1 compuesto tipo (6j−1)(6g+1)</span></span><span>
    SI existe j,g tales que 2n+</span><span><span class="hljs-number">1</span></span><span> = (6j−</span><span><span class="hljs-number">1</span></span><span>)(6g+</span><span><span class="hljs-number">1</span></span><span>):
        en_L4 = VERDADERO
    SINO:
        en_L4 = FALSO

    </span><span><span class="hljs-comment">// L2 = intersección</span></span><span>
    en_L2 = en_L3 Y en_L4

    </span><span><span class="hljs-comment">// U2 = parte limpia</span></span><span>
    SI en_L1 Y NO en_L3 Y NO en_L4:
        en_U2 = VERDADERO
    SINO:
        en_U2 = FALSO

    </span><span><span class="hljs-title function_">RETORNAR</span></span><span> </span><span><span class="hljs-params">(en_L1, en_L3, en_L4, en_L2, en_U2)</span></span><span>
</span></span></code></div></div></pre>
