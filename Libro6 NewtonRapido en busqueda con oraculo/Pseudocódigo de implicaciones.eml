237 6.136 4.40303 6.07083 4.80371 6.03809C5.14051 6.01057 5.53708 6.00551 6.00391 6.00391C6.00551 5.53708 6.01057 5.14051 6.03809 4.80371C6.0755 4.34588 6.15483 3.94012 6.34668 3.56348L6.46875 3.34473C6.77282 2.84912 7.20856 2.44514 7.72949 2.17969L7.87207 2.11328C8.20855 1.96886 8.56979 1.90385 8.9707 1.87109C9.42091 1.83432 9.978 1.83496 10.667 1.83496H13.5C14.1891 1.83496 14.746 1.83431 15.1963 1.87109C15.6541 1.90851 16.0599 1.98788 16.4365 2.17969L16.6553 2.30176C17.151 2.60585 17.5548 3.04244 17.8203 3.56348L17.8867 3.70606C18.031 4.04235 18.0962 4.40306 18.1289 4.80371C18.1657 5.25395 18.165 5.81091 18.165 6.5V9.33301Z"></path></svg>Copiar código</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre!"><span><span><span class="hljs-comment">// Entradas: E (entero objetivo), lista de (n,m,v) familias, prime_bound</span></span><span>
func </span><span><span class="hljs-title function_">methodV_on_haus</span></span><span><span class="hljs-params">(E, families, prime_bound)</span></span><span>:
    results = []
    </span><span><span class="hljs-keyword">for</span></span><span> (n,m,v) in families:
        R = </span><span><span class="hljs-number">1</span></span><span>
        </span><span><span class="hljs-keyword">for</span></span><span> k in </span><span><span class="hljs-title function_">range</span></span><span><span class="hljs-params">(m+<span class="hljs-number">1</span></span></span><span>, n+</span><span><span class="hljs-number">1</span></span><span>): R *= </span><span><span class="hljs-type">k</span></span><span>
        </span><span><span class="hljs-variable">V</span></span><span> </span><span><span class="hljs-operator">=</span></span><span> v * R
        </span><span><span class="hljs-comment">// primos en V:</span></span><span>
        </span><span><span class="hljs-keyword">for</span></span><span> r in </span><span><span class="hljs-title function_">primes_up_to</span></span><span><span class="hljs-params">(prime_bound)</span></span><span>:
            </span><span><span class="hljs-keyword">if</span></span><span> V % r != </span><span><span class="hljs-number">0</span></span><span>: </span><span><span class="hljs-keyword">continue</span></span><span>
            </span><span><span class="hljs-comment">// r divide E?</span></span><span>
            </span><span><span class="hljs-keyword">if</span></span><span> E % r != </span><span><span class="hljs-number">0</span></span><span>: </span><span><span class="hljs-keyword">continue</span></span><span>
            </span><span><span class="hljs-comment">// enumerar divisores A&lt;=sqrt(E) que sean ≡ ±1 (mod 6)</span></span><span>
            possible = False
            </span><span><span class="hljs-keyword">for</span></span><span> A in </span><span><span class="hljs-title function_">divisors_up_to_sqrt</span></span><span><span class="hljs-params">(E)</span></span><span>:
                </span><span><span class="hljs-keyword">if</span></span><span> E % A != </span><span><span class="hljs-number">0</span></span><span>: </span><span><span class="hljs-type">continue</span></span><span>
                </span><span><span class="hljs-variable">B</span></span><span> </span><span><span class="hljs-operator">=</span></span><span> E </span><span><span class="hljs-comment">// A</span></span><span>
                </span><span><span class="hljs-keyword">if</span></span><span> (A%</span><span><span class="hljs-number">6</span></span><span> in (</span><span><span class="hljs-number">1</span></span><span>,</span><span><span class="hljs-number">5</span></span><span>)) and (B%</span><span><span class="hljs-number">6</span></span><span> in (</span><span><span class="hljs-number">1</span></span><span>,</span><span><span class="hljs-number">5</span></span><span>)):
                    </span><span><span class="hljs-keyword">if</span></span><span> (A % r == </span><span><span class="hljs-number">0</span></span><span>) or (B % r == </span><span><span class="hljs-number">0</span></span><span>):
                        possible = True
                        </span><span><span class="hljs-keyword">break</span></span><span>
            </span><span><span class="hljs-keyword">if</span></span><span> not possible:
                results.append({</span><span><span class="hljs-string">"n"</span></span><span>:n,</span><span><span class="hljs-string">"m"</span></span><span>:m,</span><span><span class="hljs-string">"v"</span></span><span>:v,</span><span><span class="hljs-string">"E"</span></span><span>:E,</span><span><span class="hljs-string">"witness"</span></span><span>:r})
    </span><span><span class="hljs-keyword">return</span></span><span> results
</span></span></code></div></div></pre>
<h3 data-start="6874" data-end="6905">C.3 Observaciones prácticas</h3>
<ul data-start="6906" data-end="7550">
<li data-start="6906" data-end="7088">
<p data-start="6908" data-end="7088">Para Haus la congruencia mod 6 es la guía principal; para invalidar la factorización necesitas <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>r</mi></mrow><annotation encoding="application/x-tex">r</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 0.4306em;"></span><span class="mord mathnormal" style="margin-right: 0.02778em;">r</span></span></span></span> que no pueda dividir ningún factor congruente ±1 mod6 en la partición de <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>E</mi></mrow><annotation encoding="application/x-tex">E</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 0.6833em;"></span><span class="mord mathnormal" style="margin-right: 0.05764em;">E</span></span></span></span>.</p>
</li>
<li data-start="7089" data-end="7290">
<p data-start="7091" data-end="7290">El algoritmo requiere enumerar divisores de <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>E</mi></mrow><annotation encoding="application/x-tex">E</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 0.6833em;"></span><span class="mord mathnormal" style="margin-right: 0.05764em;">E</span></span></span></span> (hasta <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><msqrt><mi>E</mi></msqrt></mrow><annotation encoding="application/x-tex">\sqrt E</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 1.04em; vertical-align: -0.1133em;"></span><span class="mord sqrt"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height: 0.9267em;"><span class="svg-align" style="top: -3em;"><span class="pstrut" style="height: 3em;"></span><span class="mord mathnormal" style="margin-right: 0.05764em; padding-left: 0.833em;">E</span></span><span style="top: -2.8867em;"><span class="pstrut" style="height: 3em;"></span><span class="hide-tail" style="min-width: 0.853em; height: 1.08em;"><svg xmlns="http://www.w3.org/2000/svg" width="400em" height="1.08em" viewBox="0 0 400000 1080" preserveAspectRatio="xMinYMin slice"><path d="M95,702
c-2.7,0,-7.17,-2.7,-13.5,-8c-5.8,-5.3,-9.5,-10,-9.5,-14
