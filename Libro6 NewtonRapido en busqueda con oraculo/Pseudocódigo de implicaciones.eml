</span><span><span class="hljs-comment">// --- PARÁMETROS GLOBALES ---</span></span><span>
const e </span><span><span class="hljs-operator">=</span></span><span> </span><span><span class="hljs-number">2.7182818284590451</span></span><span>
const </span><span><span class="hljs-type">E_MINUS_2</span></span><span> </span><span><span class="hljs-operator">=</span></span><span> e </span><span><span class="hljs-operator">-</span></span><span> </span><span><span class="hljs-number">2.0</span></span><span>  </span><span><span class="hljs-comment">// ≈ 0.7182818284590451</span></span><span>
const </span><span><span class="hljs-type">C_CONST</span></span><span> </span><span><span class="hljs-operator">=</span></span><span> </span><span><span class="hljs-number">1.0</span></span><span> </span><span><span class="hljs-operator">-</span></span><span> </span><span><span class="hljs-type">E_MINUS_2</span></span><span> </span><span><span class="hljs-comment">// ≈ 0.2817181715409549</span></span><span>

</span><span><span class="hljs-comment">// --- CALCULAR L(n) ---</span></span><span>
</span><span><span class="hljs-keyword">func</span></span><span> </span><span><span class="hljs-title function_">compute_L</span></span><span>(n):
    </span><span><span class="hljs-keyword">return</span></span><span> floor(sqrt(n </span><span><span class="hljs-operator">+</span></span><span> </span><span><span class="hljs-number">3</span></span><span>)) </span><span><span class="hljs-operator">+</span></span><span> </span><span><span class="hljs-number">7</span></span><span>

</span><span><span class="hljs-comment">// --- CALCULAR m(n) EXACTO HASTA TOLERANCIA ---</span></span><span>
</span><span><span class="hljs-keyword">func</span></span><span> </span><span><span class="hljs-title function_">compute_m_exact</span></span><span>(n, tol</span><span><span class="hljs-operator">=</span></span><span><span class="hljs-number">1e-12</span></span><span>):
    s </span><span><span class="hljs-operator">=</span></span><span> </span><span><span class="hljs-number">0.0</span></span><span>
    sqrt_term </span><span><span class="hljs-operator">=</span></span><span> sqrt(n </span><span><span class="hljs-operator">+</span></span><span> </span><span><span class="hljs-number">3.0</span></span><span>)
    </span><span><span class="hljs-comment">// compute K as in doc: floor(floor(sqrt(n)) * 9/24)</span></span><span>
    </span><span><span class="hljs-type">K</span></span><span> </span><span><span class="hljs-operator">=</span></span><span> floor(floor(sqrt(n)) </span><span><span class="hljs-operator">*</span></span><span> </span><span><span class="hljs-number">9.0</span></span><span><span class="hljs-operator">/</span></span><span><span class="hljs-number">24.0</span></span><span>)
    </span><span><span class="hljs-keyword">if</span></span><span> </span><span><span class="hljs-type">K</span></span><span> </span><span><span class="hljs-operator">&lt;</span></span><span> </span><span><span class="hljs-number">2</span></span><span>: </span><span><span class="hljs-type">K</span></span><span> </span><span><span class="hljs-operator">=</span></span><span> </span><span><span class="hljs-number">2</span></span><span>
    term </span><span><span class="hljs-operator">=</span></span><span> </span><span><span class="hljs-number">1.0</span></span><span> </span><span><span class="hljs-operator">/</span></span><span> </span><span><span class="hljs-number">2.0</span></span><span>  </span><span><span class="hljs-comment">// corresponds to i=2 -&gt; 1/2!</span></span><span>
    i </span><span><span class="hljs-operator">=</span></span><span> </span><span><span class="hljs-number">2</span></span><span>
    </span><span><span class="hljs-keyword">while</span></span><span> i </span><span><span class="hljs-operator">&lt;=</span></span><span> </span><span><span class="hljs-type">K</span></span><span>:
        s </span><span><span class="hljs-operator">+=</span></span><span> term
        i </span><span><span class="hljs-operator">+=</span></span><span> </span><span><span class="hljs-number">1</span></span><span>
        term </span><span><span class="hljs-operator">=</span></span><span> term </span><span><span class="hljs-operator">/</span></span><span> i  </span><span><span class="hljs-comment">// update to 1/i!</span></span><span>
        </span><span><span class="hljs-keyword">if</span></span><span> term </span><span><span class="hljs-operator">*</span></span><span> sqrt_term </span><span><span class="hljs-operator">&lt;</span></span><span> tol: </span><span><span class="hljs-keyword">break</span></span><span>
    </span><span><span class="hljs-keyword">return</span></span><span> sqrt_term </span><span><span class="hljs-operator">*</span></span><span> s

</span><span><span class="hljs-comment">// --- APROXIMACIÓN RÁPIDA PARA m(n) ---</span></span><span>
</span><span><span class="hljs-keyword">func</span></span><span> </span><span><span class="hljs-title function_">compute_m_approx</span></span><span>(n):
    </span><span><span class="hljs-keyword">return</span></span><span> </span><span><span class="hljs-type">E_MINUS_2</span></span><span> </span><span><span class="hljs-operator">*</span></span><span> sqrt(n)

</span><span><span class="hljs-comment">// --- VERIFICAR CRITERIO (L - m &gt;= 2) ---</span></span><span>
</span><span><span class="hljs-keyword">func</span></span><span> </span><span><span class="hljs-title function_">check_gap</span></span><span>(n, use_approx</span><span><span class="hljs-operator">=</span></span><span><span class="hljs-literal">true</span></span><span>):
    </span><span><span class="hljs-type">L</span></span><span> </span><span><span class="hljs-operator">=</span></span><span> compute_L(n)
    </span><span><span class="hljs-keyword">if</span></span><span> use_approx:
