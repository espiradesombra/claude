8L15.959 12.3975C16.2466 12.2211 16.4808 11.9682 16.6348 11.666L16.6914 11.5361C16.7428 11.3924 16.7797 11.2026 16.8027 10.9209C16.8341 10.5374 16.835 10.0439 16.835 9.33301V6.5C16.835 5.78896 16.8341 5.29563 16.8027 4.91211C16.7797 4.63025 16.7428 4.44063 16.6914 4.29688L16.6348 4.16699C16.4807 3.86474 16.2466 3.61186 15.959 3.43555L15.833 3.36524C15.675 3.28473 15.4636 3.22797 15.0879 3.19727C14.7044 3.16593 14.211 3.16504 13.5 3.16504H10.667C9.9561 3.16504 9.46259 3.16595 9.0791 3.19727C8.79739 3.22028 8.6076 3.2572 8.46387 3.30859L8.33399 3.36524C8.03176 3.51923 7.77886 3.75343 7.60254 4.04102L7.53125 4.16699C7.4508 4.32498 7.39397 4.53655 7.36328 4.91211C7.33985 5.19893 7.33562 5.54719 7.33399 6.00195H9.33301C10.022 6.00195 10.5791 6.00131 11.0293 6.03809C11.4873 6.07551 11.8937 6.15471 12.2705 6.34668L12.4883 6.46875C12.984 6.7728 13.3878 7.20854 13.6533 7.72949L13.7197 7.87207C13.8642 8.20859 13.9292 8.56974 13.9619 8.9707C13.9987 9.42092 13.998 9.97799 13.998 10.667V12.665ZM18.165 9.33301C18.165 10.022 18.1657 10.5791 18.1289 11.0293C18.0961 11.4302 18.0311 11.7914 17.8867 12.1279L17.8203 12.2705C17.5549 12.7914 17.1509 13.2272 16.6553 13.5313L16.4365 13.6533C16.0599 13.8452 15.6541 13.9245 15.1963 13.9619C14.8593 13.9895 14.4624 13.9935 13.9951 13.9951C13.9935 14.4624 13.9895 14.8593 13.9619 15.1963C13.9292 15.597 13.864 15.9576 13.7197 16.2939L13.6533 16.4365C13.3878 16.9576 12.9841 17.3941 12.4883 17.6982L12.2705 17.8203C11.8937 18.0123 11.4873 18.0915 11.0293 18.1289C10.5791 18.1657 10.022 18.165 9.33301 18.165H6.5C5.81091 18.165 5.25395 18.1657 4.80371 18.1289C4.40306 18.0962 4.04235 18.031 3.70606 17.8867L3.56348 17.8203C3.04244 17.5548 2.60585 17.151 2.30176 16.6553L2.17969 16.4365C1.98788 16.0599 1.90851 15.6541 1.87109 15.1963C1.83431 14.746 1.83496 14.1891 1.83496 13.5V10.667C1.83496 9.978 1.83432 9.42091 1.87109 8.9707C1.90851 8.5127 1.98772 8.10625 2.17969 7.72949L2.30176 7.51172C2.60586 7.0159 3.04236 6.6122 3.56348 6.34668L3.70606 6.28027C4.04237 6.136 4.40303 6.07083 4.80371 6.03809C5.14051 6.01057 5.53708 6.00551 6.00391 6.00391C6.00551 5.53708 6.01057 5.14051 6.03809 4.80371C6.0755 4.34588 6.15483 3.94012 6.34668 3.56348L6.46875 3.34473C6.77282 2.84912 7.20856 2.44514 7.72949 2.17969L7.87207 2.11328C8.20855 1.96886 8.56979 1.90385 8.9707 1.87109C9.42091 1.83432 9.978 1.83496 10.667 1.83496H13.5C14.1891 1.83496 14.746 1.83431 15.1963 1.87109C15.6541 1.90851 16.0599 1.98788 16.4365 2.17969L16.6553 2.30176C17.151 2.60585 17.5548 3.04244 17.8203 3.56348L17.8867 3.70606C18.031 4.04235 18.0962 4.40306 18.1289 4.80371C18.1657 5.25395 18.165 5.81091 18.165 6.5V9.33301Z"></path></svg>Copiar código</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre!"><span><span><span class="hljs-comment">/* ---------------------------
   Parámetros y utilidades
   --------------------------- */</span>

</span><span><span class="hljs-function"><span class="hljs-keyword">func</span></span></span><span> </span><span><span class="hljs-title">gcd</span></span><span><span class="hljs-params">(a,b)</span></span><span> -&gt; </span><span><span class="hljs-type">int</span></span><span>  </span><span><span class="hljs-comment">// euclides</span></span><span>
</span><span><span class="hljs-function"><span class="hljs-keyword">func</span></span></span><span> </span><span><span class="hljs-title">modinv</span></span><span><span class="hljs-params">(a,m)</span></span><span> -&gt; </span><span><span class="hljs-type">int</span></span><span> </span><span><span class="hljs-comment">// inversa modular si gcd(a,m)=1</span></span><span>
</span><span><span class="hljs-function"><span class="hljs-keyword">func</span></span></span><span> </span><span><span class="hljs-title">is_prime</span></span><span><span class="hljs-params">(x)</span></span><span> -&gt; </span><span><span class="hljs-type">bool</span></span><span> </span><span><span class="hljs-comment">// primalidad (usamos Miller-Rabin en implementación real)</span></span><span>
</span><span><span class="hljs-function"><span class="hljs-keyword">func</span></span></span><span> </span><span><span class="hljs-title">small_primes_list</span></span><span><span class="hljs-params">(k)</span></span><span> -&gt; list </span><span><span class="hljs-comment">// primeros k primos</span></span><span>

<span class="hljs-comment">/* ---------------------------
   Construcción de familia modular
   --------------------------- */</span>
</span><span><span class="hljs-comment">// Construye módulo M y residuo r que evitan residuos prohibidos</span></span><span>
</span><span><span class="hljs-comment">// P := set de primos a evitar (p.ej. {2,3,5,7,...})</span></span><span>
</span><span><span class="hljs-comment">// avoid_residues := lista de congruencias que causarían factoraciones L3/L4</span></span><span>
</span><span><span class="hljs-function"><span class="hljs-keyword">func</span></span></span><span> </span><span><span class="hljs-title">build_family</span></span><span><span class="hljs-params">(P, avoid_residues)</span></span><span>:
    M = </span><span><span class="hljs-number">6</span></span><span> * product(p in P)  </span><span><span class="hljs-comment">// módulo base (incluye clase 6)</span></span><span>
    </span><span><span class="hljs-comment">// Vamos a seleccionar r por CRT imponiendo condiciones:</span></span><span>
    </span><span><span class="hljs-comment">//  - r ≡ 5 (mod 6)    (base Sofí)</span></span><span>
    </span><span><span class="hljs-comment">//  - para cada (a mod q) en avoid_residues: r ≠ a (mod q)  // evitamos formas peligrosas</span></span><span>
    </span><span><span class="hljs-comment">// Implementación práctica: elegir primos auxiliares q_i y fijar r ≡ b_i (mod q_i) con b_i que evite residuos prohibidos.</span></span><span>
    constraints = [(</span><span><span class="hljs-number">5</span></span><span>,</span><span><span class="hljs-number">6</span></span><span>)]  </span><span><span class="hljs-comment">// r ≡ 5 mod 6</span></span><span>
    </span><span><span class="hljs-keyword">for</span></span><span> q in select_auxiliary_primes():
        choose b mod q so that b not in forbidden_residues_mod_q
        constraints.</span><span><span class="hljs-built_in">append</span></span><span>((b,q))
    </span><span><span class="hljs-comment">// Resolver CRT para obtener r mod M_final</span></span><span>
    (r, M_final) = crt_from_constraints(constraints)
    </span><span><span class="hljs-keyword">return</span></span><span> (M_final, r)

<span class="hljs-comment">/* ---------------------------
   Predicados v, V, v'
   --------------------------- */</span>

</span><span><span class="hljs-comment">// v(n): cribas básicas</span></span><span>
</span><span><span class="hljs-function"><span class="hljs-keyword">func</span></span></span><span> </span><span><span class="hljs-title">predicate_v</span></span><span><span class="hljs-params">(n, P)</span></span><span>:
    </span><span><span class="hljs-keyword">for</span></span><span> p in P:
        </span><span><span class="hljs-keyword">if</span></span><span> n % p == </span><span><span class="hljs-number">0</span></span><span>: </span><span><span class="hljs-keyword">return</span></span><span> False
        </span><span><span class="hljs-keyword">if</span></span><span> (n+</span><span><span class="hljs-number">2</span></span><span>) % p == </span><span><span class="hljs-number">0</span></span><span>: </span><span><span class="hljs-keyword">return</span></span><span> False  </span><span><span class="hljs-comment">// por gemelos, evitar divisibilidad trivial</span></span><span>
    </span><span><span class="hljs-comment">// evitar residuos que crean factorizaciones (según reglas L3/L4)</span></span><span>
    </span><span><span class="hljs-keyword">if</span></span><span> matches_forbidden_pattern(n): </span><span><span class="hljs-keyword">return</span></span><span> False
    </span><span><span class="hljs-keyword">return</span></span><span> True

</span><span><span class="hljs-comment">// V(n): Test-V completo (memorias, 9-restos, acumuladores)</span></span><span>
</span><span><span class="hljs-comment">// devolvemos además detalles para las implicaciones</span></span><span>
</span><span><span class="hljs-function"><span class="hljs-keyword">func</span></span></span><span> </span><span><span class="hljs-title">predicate_V</span></span><span><span class="hljs-params">(n)</span></span><span>:
    </span><span><span class="hljs-comment">// calcular acumuladores t = (n-1)^2, tt = n^2, nt = (n+1)^2 etc según tu esquema</span></span><span>
    t = (n</span><span><span class="hljs-number">-1</span></span><span>)**</span><span><span class="hljs-number">2</span></span><span>; tt = n**</span><span><span class="hljs-number">2</span></span><span>; nt = (n+</span><span><span class="hljs-number">1</span></span><span>)**</span><span><span class="hljs-number">2</span></span><span>
    </span><span><span class="hljs-comment">// construir 9-restos y aplicar mapa lógico (Karnaugh-derived)</span></span><span>
    bits = compute_9_remainders_and_bools(t,tt,nt,n)
    </span><span><span class="hljs-comment">// aplicar reglas lógicas de Test-V (paso1, paso2, paso3) como en el doc</span></span><span>
    paso1 = rule_paso1(bits)
    paso2 = rule_paso2(bits, paso1)
    paso3 = rule_paso3(bits, paso2)
    V_pass = (paso1 and paso2 and paso3)  </span><span><span class="hljs-comment">// ejemplo; el esquema real usa memorias y ORs</span></span><span>
    </span><span><span class="hljs-keyword">return</span></span><span> (V_pass, { </span><span><span class="hljs-string">"paso1"</span></span><span>:paso1, </span><span><span class="hljs-string">"paso2"</span></span><span>:paso2, </span><span><span class="hljs-string">"paso3"</span></span><span>:paso3 })

</span><span><span class="hljs-comment">// v'(n): condición reforzada (ejemplo: V(n) y 2n+1 libre de pequeños factores)</span></span><span>
</span><span><span class="hljs-function"><span class="hljs-keyword">func</span></span></span><span> </span><span><span class="hljs-title">predicate_vprime</span></span><span><span class="hljs-params">(n, Q)</span></span><span>:
    (V_pass, details) = predicate_V(n)
    </span><span><span class="hljs-keyword">if</span></span><span> not V_pass: </span><span><span class="hljs-keyword">return</span></span><span> False
    </span><span><span class="hljs-keyword">for</span></span><span> p in Q:  </span><span><span class="hljs-comment">// Q: conjunto de primos a comprobar</span></span><span>
        </span><span><span class="hljs-keyword">if</span></span><span> (</span><span><span class="hljs-number">2</span></span><span>*n + </span><span><span class="hljs-number">1</span></span><span>) % p == </span><span><span class="hljs-number">0</span></span><span>: </span><span><span class="hljs-keyword">return</span></span><span> False
    </span><span><span class="hljs-keyword">return</span></span><span> True

<span class="hljs-comment">/* ---------------------------
   Generador / comprobador principal
   --------------------------- */</span>
</span><span><span class="hljs-function"><span class="hljs-keyword">func</span></span></span><span> </span><span><span class="hljs-title">methodV_run</span></span><span><span class="hljs-params">(limit_members, P, Q)</span></span><span>:
    </span><span><span class="hljs-comment">// 1) construir familia modular</span></span><span>
    (M, r) = build_family(P, avoid_residues_from_document)
    count_v = </span><span><span class="hljs-number">0</span></span><span>
    count_V = </span><span><span class="hljs-number">0</span></span><span>
    count_vp = </span><span><span class="hljs-number">0</span></span><span>
    solutions = []
    </span><span><span class="hljs-comment">// 2) recorrer miembros de la familia (infinita en teoría; en práctica iterar primeros limit_members)</span></span><span>
    k = </span><span><span class="hljs-number">0</span></span><span>
    while k &lt; limit_members:
        n = r + k * M
        </span><span><span class="hljs-comment">// comprobaciones rápidas</span></span><span>
        </span><span><span class="hljs-keyword">if</span></span><span> not predicate_v(n, P):
            k += </span><span><span class="hljs-number">1</span></span><span>
            </span><span><span class="hljs-keyword">continue</span></span><span>  </span><span><span class="hljs-comment">// SI NOT v(n) ⇒ descartado rápido</span></span><span>
        count_v += </span><span><span class="hljs-number">1</span></span><span>
        </span><span><span class="hljs-comment">// ahora aplicar Test-V</span></span><span>
        (V_pass, details) = predicate_V(n)
        </span><span><span class="hljs-keyword">if</span></span><span> V_pass:
            count_V += </span><span><span class="hljs-number">1</span></span><span>
            </span><span><span class="hljs-comment">// comprobar v'</span></span><span>
            </span><span><span class="hljs-keyword">if</span></span><span> predicate_vprime(n, Q):
                count_vp += </span><span><span class="hljs-number">1</span></span><span>
            solutions.</span><span><span class="hljs-built_in">append</span></span><span>( (n, V_pass, details) )
        k += </span><span><span class="hljs-number">1</span></span><span>
    </span><span><span class="hljs-keyword">return</span></span><span> { </span><span><span class="hljs-string">"M"</span></span><span>:M, </span><span><span class="hljs-string">"r"</span></span><span>:r, </span><span><span class="hljs-string">"count_v"</span></span><span>:count_v, </span><span><span class="hljs-string">"count_V"</span></span><span>:count_V, </span><span><span class="hljs-string">"count_v'"</span></span><span>:count_vp, </span><span><span class="hljs-string">"solutions"</span></span><span>:solutions }

<span class="hljs-comment">/* ---------------------------
   Observaciones lógicas (implicaciones)
   --------------------------- */</span>
</span><span><span class="hljs-comment">// SI predicate_v(n) == True  ENTONCES n es candidato (v)</span></span><span>
</span><span><span class="hljs-comment">// SI predicate_V(n) == True  ENTONCES v(n) ≈ True  (Test-V falla solo si v no se cumple)</span></span><span>
</span><span><span class="hljs-comment">// SI predicate_vprime(n) == True ENTONCES V(n) y 2n+1 sin factores pequeños (v')</span></span><span>
</span><span><span class="hljs-comment">// Por tanto: v(n) ⇒ (posible) V(n) ⇒ v'(n) según el filtrado.</span></span><span>
</span></span></code></div></div></pre>
<hr data-start="10433" data-end="10436">
<h1 data-start="10438" data-end="10471">Comentarios finales y garantías</h1>
<ul data-start="10473" data-end="11425">
<li data-start="10473" data-end="10851">
<p data-start="10475" data-end="10851">El método construye familias infinitas por CRT/TCR. Eso <strong data-start="10531" data-end="10547">no garantiza</strong> que cada familia contenga primos, pero por Dirichlet (si impones congruencias coprimas) obtienes infinitos primos en la progresión; con las condiciones de evitar residuos prohibidos, puedes forzar que esos primos también cumplan otras propiedades (o al menos no tengan las factorizaciones prohibidas).</p>
</li>
<li data-start="10852" data-end="11217">
<p data-start="10854" data-end="11217">La frase que llevabas sobre <code data-start="10882" data-end="10900">2(n−1) &gt; m &gt; v−1</code> la he interpretado como una condición de parámetros que fuerza la aparición de un primo divisor que desactiva una factorización — en el pseudocódigo eso se modela como chequeo adicional: si ciertos acumuladores producen un prime divisor <code data-start="11138" data-end="11141">p</code> bajo las condiciones, marcamos que la factorización queda imposibilitada.</p>
</li>
<li data-start="11218" data-end="11425">
<p data-start="11220" data-end="11425">La cadena de implicaciones <code data-start="11247" data-end="11259">v ⇒ V ⇒ v'</code> está explicitada: <code data-start="11278" data-end="11281">v</code> (cribas básicas) es requisito, <code data-start="11313" data-end="11316">V</code> es el Test-V completo, <code data-start="11340" data-end="11344">v'</code> la condición reforzada — y el pseudocódigo implementa exactamente esa jerarquía.</p>
</li>
</ul>
<hr data-start="11427" data-end="11430">
<p data-start="11432" data-end="11504">Si quieres ahora <strong data-start="11449" data-end="11491">hago cualquiera de estas tres acciones</strong> (elige una):</p>
<ol data-start="11506" data-end="12068">
<li data-start="11506" data-end="11688">
<p data-start="11509" data-end="11688"><strong data-start="11509" data-end="11585">Traducir el pseudocódigo a Python real y ejecutar un pequeño experimento</strong> (ej.: construir una familia con P={2,3,5,7}, iterar 10k miembros y reportar cuántos pasan v, V, v′).</p>
</li>
<li data-start="11689" data-end="11849">
<p data-start="11692" data-end="11849"><strong data-start="11692" data-end="11717">Formalizar el teorema</strong> (enunciado + demostración breve estilo paper, LaTeX-friendly) sobre “familias infinitas que contienen miembros que pasan Test-V”.</p>
</li>
<li data-start="11850" data-end="12068">
<p data-start="11853" data-end="12068"><strong data-start="11853" data-end="11885">Afinar la condición numérica</strong> que mencionaste (<code data-start="11903" data-end="11921">2(n−1) &gt; m &gt; v−1</code>) y convertirla en un criterio explícito y verificable dentro de <code data-start="11986" data-end="11999">predicate_V</code> (explicar exactamente qué es <code data-start="12029" data-end="12032">m</code> y <code data-start="12035" data-end="12038">v</code> y codificar la comprobación).</p>
</li>
</ol>
<p data-start="12070" data-end="12141" data-is-last-node="" data-is-only-node="">Dime <code data-start="12075" data-end="12078">1</code>, <code data-start="12080" data-end="12083">2</code> o <code data-start="12086" data-end="12089">3</code>. Si quieres otra cosa, dilo directamente y la hago.</p></div></div></div></div></div></div></article><article class="text-token-text-primary w-full focus:outline-none [--shadow-height:45px] has-data-writing-block:pointer-events-none has-data-writing-block:-mt-(--shadow-height) has-data-writing-block:pt-(--shadow-height) [&amp;:has([data-writing-block])&gt;*]:pointer-events-auto scroll-mt-(--header-height)" tabindex="-1" dir="auto" data-turn-id="f620be3d-ebc4-41ca-b134-61b5aaff396b" data-testid="conversation-turn-19" data-scroll-anchor="false" data-turn="user"><h5 class="sr-only">Dijiste:</h5><div class="text-base my-auto mx-auto pt-12 [--thread-content-margin:--spacing(4)] @w-sm/main:[--thread-content-margin:--spacing(6)] @w-lg/main:[--thread-content-margin:--spacing(16)] px-(--thread-content-margin)"><div class="[--thread-content-max-width:40rem] @w-lg/main:[--thread-content-max-width:48rem] mx-auto max-w-(--thread-content-max-width) flex-1 group/turn-messages focus-visible:outline-hidden mb-10 relative flex w-full min-w-0 flex-col" tabindex="-1"><div class="flex max-w-full flex-col grow"><div data-message-author-role="user" data-message-id="f620be3d-ebc4-41ca-b134-61b5aaff396b" dir="auto" class="min-h-8 text-message relative flex w-full flex-col items-end gap-2 text-start break-words whitespace-normal [.text-message+&amp;]:mt-1"><div class="flex w-full flex-col gap-1 empty:hidden items-end rtl:items-start"><div class="user-message-bubble-color corner-superellipse/1.1 relative rounded-[18px] px-4 py-1.5 data-[multiline]:py-3 max-w-[var(--user-chat-width,70%)]"><div class="whitespace-pre-wrap">Tendí el rango exacto</div></div></div></div></div></div></div></article><article class="text-token-text-primary w-full focus:outline-none [--shadow-height:45px] has-data-writing-block:pointer-events-none has-data-writing-block:-mt-(--shadow-height) has-data-writing-block:pt-(--shadow-height) [&amp;:has([data-writing-block])&gt;*]:pointer-events-auto [content-visibility:auto] supports-[content-visibility:auto]:[contain-intrinsic-size:auto_100lvh] scroll-mt-[calc(var(--header-height)+min(200px,max(70px,20svh)))]" tabindex="-1" dir="auto" data-turn-id="508d4297-6eed-49b9-9311-2cb84770dd03" data-testid="conversation-turn-20" data-scroll-anchor="false" data-turn="assistant"><h6 class="sr-only">ChatGPT dijo:</h6><div class="text-base my-auto mx-auto [--thread-content-margin:--spacing(4)] @w-sm/main:[--thread-content-margin:--spacing(6)] @w-lg/main:[--thread-content-margin:--spacing(16)] px-(--thread-content-margin)"><div class="[--thread-content-max-width:40rem] @w-lg/main:[--thread-content-max-width:48rem] mx-auto max-w-(--thread-content-max-width) flex-1 group/turn-messages focus-visible:outline-hidden relative flex w-full min-w-0 flex-col agent-turn" tabindex="-1"><div class="flex max-w-full flex-col grow"><div data-message-author-role="assistant" data-message-id="508d4297-6eed-49b9-9311-2cb84770dd03" dir="auto" class="min-h-8 text-message relative flex w-full flex-col items-end gap-2 text-start break-words whitespace-normal [.text-message+&amp;]:mt-1" data-message-model-slug="gpt-5-1"><div class="flex w-full flex-col gap-1 empty:hidden first:pt-[1px]"><div class="markdown prose dark:prose-invert w-full break-words light markdown-new-styling"><p data-start="0" data-end="91">Perfecto — <strong data-start="11" data-end="49">para poder darte “el rango exacto”</strong> necesito <strong data-start="59" data-end="90">una cosa muy concreta de ti</strong>:</p>
<p data-start="93" data-end="155">👉 <strong data-start="96" data-end="153">¿A qué variables EXACTAS te refieres cuando escribes:</strong></p>
<span class="katex-display"><span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><mn>2</mn><mo stretchy="false">(</mo><mi>n</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo><mtext>  </mtext><mo>&gt;</mo><mtext>  </mtext><mi>m</mi><mtext>  </mtext><mo>&gt;</mo><mtext>  </mtext><mi>v</mi><mo>−</mo><mn>1</mn><mtext>  </mtext><mo stretchy="false">?</mo></mrow><annotation encoding="application/x-tex">2(n-1)\;&gt;\;m\;&gt;\;v-1\; ?</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 1em; vertical-align: -0.25em;"></span><span class="mord">2</span><span class="mopen">(</span><span class="mord mathnormal">n</span><span class="mspace" style="margin-right: 0.2222em;"></span><span class="mbin">−</span><span class="mspace" style="margin-right: 0.2222em;"></span></span><span class="base"><span class="strut" style="height: 1em; vertical-align: -0.25em;"></span><span class="mord">1</span><span class="mclose">)</span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">&gt;</span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 0.5782em; vertical-align: -0.0391em;"></span><span class="mord mathnormal">m</span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">&gt;</span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 0.6667em; vertical-align: -0.0833em;"></span><span class="mord mathnormal" style="margin-right: 0.03588em;">v</span><span class="mspace" style="margin-right: 0.2222em;"></span><span class="mbin">−</span><span class="mspace" style="margin-right: 0.2222em;"></span></span><span class="base"><span class="strut" style="height: 0.6944em;"></span><span class="mord">1</span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mclose">?</span></span></span></span></span>
<p data-start="188" data-end="424">Porque en tu documento y en tu método-V aparecen <strong data-start="237" data-end="256">tres candidatos</strong> a lo que puede ser <code data-start="276" data-end="279">m</code> y <strong data-start="282" data-end="289">dos</strong> para lo que puede ser <code data-start="312" data-end="315">v</code>, y necesito saber <strong data-start="334" data-end="370">cuál de ellos estás usando ahora</strong>, para darte el rango correcto y su derivación exacta.</p>
<p data-start="426" data-end="499">Aquí te pongo las posibles interpretaciones para que elijas <strong data-start="486" data-end="498">1, 2 o 3</strong>:</p>
<hr data-start="501" data-end="504">
<h1 data-start="506" data-end="547">🔍 Posible significado 1 (muy probable)</h1>
<p data-start="548" data-end="573">En el <strong data-start="554" data-end="566">método-V</strong> había:</p>
<ul data-start="575" data-end="854">
<li data-start="575" data-end="610">
<p data-start="577" data-end="610"><code data-start="577" data-end="580">n</code>: número base (posible primo).</p>
</li>
<li data-start="611" data-end="707">
<p data-start="613" data-end="707"><code data-start="613" data-end="616">v</code>: <strong data-start="618" data-end="642">contador de bloqueos</strong> o nivel de criba superado (v = número de condiciones cumplidas).</p>
</li>
<li data-start="708" data-end="854">
<p data-start="710" data-end="755"><code data-start="710" data-end="713">m</code>: <strong data-start="715" data-end="739">profundidad del test</strong>, equivalente a:</p>
<ul data-start="758" data-end="854">
<li data-start="758" data-end="794">
<p data-start="760" data-end="794">número de pasos de acumuladores,</p>
</li>
<li data-start="797" data-end="854">
<p data-start="799" data-end="854">o posición del “marco” dentro del bucle del test (m&lt;n).</p>
</li>
</ul>
</li>
</ul>
<p data-start="856" data-end="888">En esta interpretación el rango:</p>
<span class="katex-display"><span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><mn>2</mn><mo stretchy="false">(</mo><mi>n</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo><mo>&gt;</mo><mi>m</mi><mo>&gt;</mo><mi>v</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">2(n-1) &gt; m &gt; v-1</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 1em; vertical-align: -0.25em;"></span><span class="mord">2</span><span class="mopen">(</span><span class="mord mathnormal">n</span><span class="mspace" style="margin-right: 0.2222em;"></span><span class="mbin">−</span><span class="mspace" style="margin-right: 0.2222em;"></span></span><span class="base"><span class="strut" style="height: 1em; vertical-align: -0.25em;"></span><span class="mord">1</span><span class="mclose">)</span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">&gt;</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 0.5782em; vertical-align: -0.0391em;"></span><span class="mord mathnormal">m</span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">&gt;</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 0.6667em; vertical-align: -0.0833em;"></span><span class="mord mathnormal" style="margin-right: 0.03588em;">v</span><span class="mspace" style="margin-right: 0.2222em;"></span><span class="mbin">−</span><span class="mspace" style="margin-right: 0.2222em;"></span></span><span class="base"><span class="strut" style="height: 0.6444em;"></span><span class="mord">1</span></span></span></span></span>
<p data-start="912" data-end="922">significa:</p>
<p data-start="924" data-end="1048"><strong data-start="924" data-end="1047">“el test ha avanzado lo suficiente (m &gt; v-1) pero no ha llegado a los duplicados o redundancias del final (m &lt; 2(n-1))”</strong>.</p>
<p data-start="1050" data-end="1112">👉 Si es esta opción, puedo darte <strong data-start="1084" data-end="1111">el rango cerrado exacto</strong>:</p>
<span class="katex-display"><span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><mi>m</mi><mo>∈</mo><mo stretchy="false">{</mo><mi>v</mi><mo separator="true">,</mo><mtext>  </mtext><mi>v</mi><mo>+</mo><mn>1</mn><mo separator="true">,</mo><mtext>  </mtext><mi>v</mi><mo>+</mo><mn>2</mn><mo separator="true">,</mo><mtext>  </mtext><mo>…</mo><mo separator="true">,</mo><mtext>  </mtext><mn>2</mn><mi>n</mi><mo>−</mo><mn>3</mn><mo separator="true">,</mo><mtext>  </mtext><mn>2</mn><mi>n</mi><mo>−</mo><mn>2</mn><mo stretchy="false">}</mo><mi mathvariant="normal">.</mi></mrow><annotation encoding="application/x-tex">m \in \{v,\; v+1,\; v+2,\;\dots,\; 2n-3,\; 2n-2\}.</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 0.5782em; vertical-align: -0.0391em;"></span><span class="mord mathnormal">m</span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">∈</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 1em; vertical-align: -0.25em;"></span><span class="mopen">{</span><span class="mord mathnormal" style="margin-right: 0.03588em;">v</span><span class="mpunct">,</span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mspace" style="margin-right: 0.1667em;"></span><span class="mord mathnormal" style="margin-right: 0.03588em;">v</span><span class="mspace" style="margin-right: 0.2222em;"></span><span class="mbin">+</span><span class="mspace" style="margin-right: 0.2222em;"></span></span><span class="base"><span class="strut" style="height: 0.8389em; vertical-align: -0.1944em;"></span><span class="mord">1</span><span class="mpunct">,</span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mspace" style="margin-right: 0.1667em;"></span><span class="mord mathnormal" style="margin-right: 0.03588em;">v</span><span class="mspace" style="margin-right: 0.2222em;"></span><span class="mbin">+</span><span class="mspace" style="margin-right: 0.2222em;"></span></span><span class="base"><span class="strut" style="height: 0.8389em; vertical-align: -0.1944em;"></span><span class="mord">2</span><span class="mpunct">,</span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mspace" style="margin-right: 0.1667em;"></span><span class="minner">…</span><span class="mspace" style="margin-right: 0.1667em;"></span><span class="mpunct">,</span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mspace" style="margin-right: 0.1667em;"></span><span class="mord">2</span><span class="mord mathnormal">n</span><span class="mspace" style="margin-right: 0.2222em;"></span><span class="mbin">−</span><span class="mspace" style="margin-right: 0.2222em;"></span></span><span class="base"><span class="strut" style="height: 0.8389em; vertical-align: -0.1944em;"></span><span class="mord">3</span><span class="mpunct">,</span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mspace" style="margin-right: 0.1667em;"></span><span class="mord">2</span><span class="mord mathnormal">n</span><span class="mspace" style="margin-right: 0.2222em;"></span><span class="mbin">−</span><span class="mspace" style="margin-right: 0.2222em;"></span></span><span class="base"><span class="strut" style="height: 1em; vertical-align: -0.25em;"></span><span class="mord">2</span><span class="mclose">}</span><span class="mord">.</span></span></span></span></span>
<p data-start="1172" data-end="1189">y la implicación:</p>
<pre class="overflow-visible!" data-start="1191" data-end="1266"><div class="contain-inline-size rounded-2xl corner-superellipse/1.1 relative bg-token-sidebar-surface-primary"><div class="flex items-center text-token-text-secondary px-4 py-2 text-xs font-sans justify-between h-9 bg-token-sidebar-surface-primary select-none rounded-t-2xl corner-t-superellipse/1.1">css</div><div class="sticky top-9"><div class="absolute end-0 bottom-0 flex h-9 items-center pe-2"><div class="bg-token-bg-elevated-secondary text-token-text-secondary flex items-center gap-4 rounded-sm px-2 font-sans text-xs"><button class="flex gap-1 items-center select-none py-1" aria-label="Copiar"><svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="icon-sm"><path d="M12.668 10.667C12.668 9.95614 12.668 9.46258 12.6367 9.0791C12.6137 8.79732 12.5758 8.60761 12.5244 8.46387L12.4688 8.33399C12.3148 8.03193 12.0803 7.77885 11.793 7.60254L11.666 7.53125C11.508 7.45087 11.2963 7.39395 10.9209 7.36328C10.5374 7.33197 10.0439 7.33203 9.33301 7.33203H6.5C5.78896 7.33203 5.29563 7.33195 4.91211 7.36328C4.63016 7.38632 4.44065 7.42413 4.29688 7.47559L4.16699 7.53125C3.86488 7.68518 3.61186 7.9196 3.43555 8.20703L3.36524 8.33399C3.28478 8.49198 3.22795 8.70352 3.19727 9.0791C3.16595 9.46259 3.16504 9.95611 3.16504 10.667V13.5C3.16504 14.211 3.16593 14.7044 3.19727 15.0879C3.22797 15.4636 3.28473 15.675 3.36524 15.833L3.43555 15.959C3.61186 16.2466 3.86474 16.4807 4.16699 16.6348L4.29688 16.6914C4.44063 16.7428 4.63025 16.7797 4.91211 16.8027C5.29563 16.8341 5.78896 16.835 6.5 16.835H9.33301C10.0439 16.835 10.5374 16.8341 10.9209 16.8027C11.2965 16.772 11.508 16.7152 11.666 16.6348L11.793 16.5645C12.0804 16.3881 12.3148 16.1351 12.4688 15.833L12.5244 15.7031C12.5759 15.5594 12.6137 15.3698 12.6367 15.0879C12.6681 14.7044 12.668 14.211 12.668 13.5V10.667ZM13.998 12.665C14.4528 12.6634 14.8011 12.6602 15.0879 12.6367C15.4635 12.606 15.675 12.5492 15.833 12.468