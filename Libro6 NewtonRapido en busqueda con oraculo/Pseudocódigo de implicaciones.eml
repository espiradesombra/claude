04237 6.136 4.40303 6.07083 4.80371 6.03809C5.14051 6.01057 5.53708 6.00551 6.00391 6.00391C6.00551 5.53708 6.01057 5.14051 6.03809 4.80371C6.0755 4.34588 6.15483 3.94012 6.34668 3.56348L6.46875 3.34473C6.77282 2.84912 7.20856 2.44514 7.72949 2.17969L7.87207 2.11328C8.20855 1.96886 8.56979 1.90385 8.9707 1.87109C9.42091 1.83432 9.978 1.83496 10.667 1.83496H13.5C14.1891 1.83496 14.746 1.83431 15.1963 1.87109C15.6541 1.90851 16.0599 1.98788 16.4365 2.17969L16.6553 2.30176C17.151 2.60585 17.5548 3.04244 17.8203 3.56348L17.8867 3.70606C18.031 4.04235 18.0962 4.40306 18.1289 4.80371C18.1657 5.25395 18.165 5.81091 18.165 6.5V9.33301Z"></path></svg>Copiar código</button></div></div></div><div class="overflow-y-auto p-4" dir="ltr"><code class="whitespace-pre!"><span><span><span class="hljs-comment">/* Parámetros */</span></span><span>
tau = </span><span><span class="hljs-number">1e-8</span></span><span>        </span><span><span class="hljs-comment">// umbral relativo para sigma_min/sigma_max</span></span><span>
bootstrap_N = </span><span><span class="hljs-number">200</span></span><span> </span><span><span class="hljs-comment">// muestras por incertidumbre para robustez</span></span><span>

</span><span><span class="hljs-comment">/* Funciones auxiliares */</span></span><span>
</span><span><span class="hljs-function">func <span class="hljs-title">log_of</span></span></span><span>(</span><span><span class="hljs-params">E, <span class="hljs-keyword">base</span></span></span><span>=</span><span><span class="hljs-string">'e'</span></span><span>):
    </span><span><span class="hljs-keyword">if</span></span><span> </span><span><span class="hljs-keyword">base</span></span><span> == </span><span><span class="hljs-string">'e'</span></span><span>: </span><span><span class="hljs-keyword">return</span></span><span> ln(E)
    </span><span><span class="hljs-keyword">else</span></span><span> </span><span><span class="hljs-keyword">if</span></span><span> </span><span><span class="hljs-keyword">base</span></span><span> == </span><span><span class="hljs-number">10</span></span><span>: </span><span><span class="hljs-keyword">return</span></span><span> log10(E)
    ...

<span class="hljs-comment">/* Construcción de la matriz de observaciones:
   Cada observación puede tener más de 1 feature, por ejemplo:
   - y_i = [ ln(E_i), ln(root_estimate_i), normalized_log_ratio_i, ... ]
   Cuantas más features tenga cada observación, mejor la SVD. */</span>

</span><span><span class="hljs-function">func <span class="hljs-title">build_feature_vector</span></span></span><span>(</span><span><span class="hljs-params">E_i, optional_context</span></span><span>):
    f1 = log_of(E_i)
    </span><span><span class="hljs-comment">// ejemplo de features adicionales para "log y raiz"</span></span><span>
    root_approx = sqrt(E_i)                 </span><span><span class="hljs-comment">// raíz estimada</span></span><span>
    f2 = log_of(root_approx)
    f3 = f1 - </span><span><span class="hljs-number">2</span></span><span>*f2      </span><span><span class="hljs-comment">// residuo en identidad log(E) ?= 2 log(root)</span></span><span>
    </span><span><span class="hljs-comment">// añadir más según dominio</span></span><span>
    </span><span><span class="hljs-keyword">return</span></span><span> [f1, f2, f3]

</span><span><span class="hljs-comment">/* Test de conexión nula con incertidumbre (bootstrap) */</span></span><span>
</span><span><span class="hljs-function">func <span class="hljs-title">test_connection_null</span></span></span><span>(</span><span><span class="hljs-params">observations, epsilons, tau, bootstrap_N</span></span><span>):
    </span><span><span class="hljs-comment">// observations: list of E_i (o feature vectors y_i)</span></span><span>
    </span><span><span class="hljs-comment">// epsilons: listas of tolerated +/- per feature (same shape)</span></span><span>
    </span><span><span class="hljs-comment">// form sample matrix Y_s for s=1..bootstrap_N where each feature sampled uniformly in its interval</span></span><span>
    count_degenerate = </span><span><span class="hljs-number">0</span></span><span>
    </span><span><span class="hljs-keyword">for</span></span><span> s </span><span><span class="hljs-keyword">in</span></span><span> </span><span><span class="hljs-number">1.</span></span><span>.bootstrap_N:
        Y_s = []
        </span><span><span class="hljs-keyword">for</span></span><span> i=</span><span><span class="hljs-number">1.</span></span><span>.len(observations):
            base_vector = build_feature_vector(observations[i])
            sampled_vector = []
            </span><span><span class="hljs-keyword">for</span></span><span> j, </span><span><span class="hljs-function">val <span class="hljs-keyword">in</span></span></span><span> </span><span><span class="hljs-title">enumerate</span></span><span>(</span><span><span class="hljs-params">base_vector</span></span><span>):
                e = epsilons[i][j]
                sampled_vector.append( val + uniform(-e, e) )
            Y_s.append(sampled_vector)
        </span><span><span class="hljs-comment">// center rows (subtract column means)</span></span><span>
        Yc = center_rows(matrix(Y_s))  </span><span><span class="hljs-comment">// matrix shape x × d</span></span><span>
        </span><span><span class="hljs-comment">// SVD</span></span><span>
        U,S,Vt = svd(Yc) 
        sigma_max = S[</span><span><span class="hljs-number">0</span></span><span>]; sigma_min = S[</span><span><span class="hljs-number">-1</span></span><span>]
        </span><span><span class="hljs-keyword">if</span></span><span> sigma_min / sigma_max &lt; tau:
            count_degenerate += </span><span><span class="hljs-number">1</span></span><span>
    </span><span><span class="hljs-comment">// if degenerate in most bootstrap samples =&gt; stop</span></span><span>
    </span><span><span class="hljs-keyword">if</span></span><span> count_degenerate / bootstrap_N &gt;= </span><span><span class="hljs-number">0.95</span></span><span>:
        </span><span><span class="hljs-keyword">return</span></span><span> True
    </span><span><span class="hljs-keyword">else</span></span><span>:
        </span><span><span class="hljs-keyword">return</span></span><span> False

</span><span><span class="hljs-comment">/* Bucle principal */</span></span><span>
observations = []   </span><span><span class="hljs-comment">// list of E_i</span></span><span>
epsilons = []       </span><span><span class="hljs-comment">// list of corresponding epsilon vectors</span></span><span>

</span><span><span class="hljs-keyword">while</span></span><span> True:
    </span><span><span class="hljs-comment">// 1) generate / measure next E_i (using "log method pre-salto exponencial" to choose factors)</span></span><span>
    E_new, eps_new = propose_new_equation(...)  </span><span><span class="hljs-comment">// your factor-adjustment logic</span></span><span>
    observations.append(E_new)
    epsilons.append(eps_new)

    </span><span><span class="hljs-comment">// 2) test connection null</span></span><span>
    </span><span><span class="hljs-function"><span class="hljs-keyword">if</span></span></span><span> </span><span><span class="hljs-title">len</span></span><span>(</span><span><span class="hljs-params">observations</span></span><span>) &gt;= </span><span><span class="hljs-number">3</span></span><span>:
        is_null = test_connection_null(observations, epsilons, tau, bootstrap_N)
        </span><span><span class="hljs-keyword">if</span></span><span> is_null:
            print(</span><span><span class="hljs-string">"CONEXIÓN NULA detectada: paro de búsqueda — implicación no existe"</span></span><span>)
            </span><span><span class="hljs-keyword">break</span></span><span>
    </span><span><span class="hljs-comment">// else: continue adding dims</span></span><span>
</span></span></code></div></div></pre>
<p data-start="6820" data-end="6826">Notas:</p>
<ul data-start="6827" data-end="7242">
<li data-start="6827" data-end="6978">
<p data-start="6829" data-end="6978"><code data-start="6829" data-end="6856">propose_new_equation(...)</code> es donde usas el <strong data-start="6874" data-end="6888">método log</strong> para elegir factores antes del salto exponencial (ver apartado siguiente sobre ajuste).</p>
</li>
<li data-start="6979" data-end="7153">
<p data-start="6981" data-end="7153"><code data-start="6981" data-end="7003">build_feature_vector</code> debe diseñarse para representar la estructura que buscas (ej.: multiplicativa → log lineariza, raíces → usar <span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>log</mi><mo>⁡</mo><mo stretchy="false">(</mo><msqrt><mo lspace="0em" rspace="0em">⋅</mo></msqrt><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\log(\sqrt{\cdot})</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 1.0572em; vertical-align: -0.25em;"></span><span class="mop">lo<span style="margin-right: 0.01389em;">g</span></span><span class="mopen">(</span><span class="mord sqrt"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height: 0.8072em;"><span class="svg-align" style="top: -3em;"><span class="pstrut" style="height: 3em;"></span><span class="mord" style="padding-left: 0.833em;"><span class="mord">⋅</span></span></span><span style="top: -2.7672em;"><span class="pstrut" style="height: 3em;"></span><span class="hide-tail" style="min-width: 0.853em; height: 1.08em;"><svg xmlns="http://www.w3.org/2000/svg" width="400em" height="1.08em" viewBox="0 0 400000 1080" preserveAspectRatio="xMinYMin slice"><path d="M95,702
